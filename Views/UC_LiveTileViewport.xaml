<UserControl x:Class="NPC_Plugin_Chooser_2.Views.UC_LiveTileViewport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:l="clr-namespace:NPC_Plugin_Chooser_2.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:NPC_Plugin_Chooser_2.View_Models"
             xmlns:glWpf="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance Type=vm:VM_InternalMugshotPreview}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <!-- Chrome-less miniature 3D viewport for a "live" mugshot tile: just the
         GL surface plus a loading dim. All camera interaction (orbit / pan /
         zoom) is wired in code-behind; there are no toolbars, panels, badge
         overlays, or crop rectangles — those belong to the full preview UC. -->
    <Grid x:Name="ViewportRoot" ClipToBounds="True" Background="#222">
        <glWpf:GLWpfControl x:Name="GlControl" Render="GlControl_OnRender"/>
        <Border Background="#80000000"
                Visibility="{Binding Viewer.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <TextBlock Text="{l:Loc loading}" Foreground="White" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
