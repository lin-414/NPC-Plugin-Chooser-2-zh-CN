                    <TextBlock Text="{l:Loc whenImportingChoicesFrom}" FontSize="10" Foreground="{DynamicResource HintForeground}" TextWrapping="Wrap"/>
                </StackPanel>
            </Expander>
            <Expander Header="{l:Loc modImportSettings}" Style="{StaticResource SettingsSectionExpander}"
                      Margin="0,5,0,10"
                      IsExpanded="{Binding SectionModImport.IsExpanded, Mode=TwoWay}">
                <StackPanel>
                    <TextBlock Text="{l:Loc nonAppearanceMods}" Margin="0,0,0,2"/>

                    <TextBlock Text="{l:Loc theHighlightedModsCould}"
                               Foreground="{DynamicResource StatusErrorForeground}"
                               TextWrapping="Wrap"
                               FontStyle="Italic"
                               FontSize="10"
                               Margin="0,0,0,4"
                               Visibility="{Binding HasMissingMasterMods, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <TextBox Text="{Binding NonAppearanceModFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,3" ToolTip="{l:Loc filterTheListOfNon2}"/>

                          <ListBox ItemsSource="{Binding FilteredNonAppearanceMods}" Height="150" HorizontalContentAlignment="Stretch" BorderThickness="1">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2">
