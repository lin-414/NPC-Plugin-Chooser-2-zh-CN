                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Button Grid.Column="1"
                                    Content="🔄"
                                    Command="{Binding DataContext.RescanCachedModCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding Path}"
                                    ToolTip="{l:Loc reScanThisFolder}"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                             <Button Grid.Column="2"
                                    Content="X"
                                    Command="{Binding DataContext.RemoveCachedModCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding Path}"
                                    Foreground="{DynamicResource StatusErrorForeground}"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

                    <TextBlock Text="{l:Loc theseModsHaveBeen}"
                               FontSize="10" 
                               Foreground="{DynamicResource HintForeground}" 
                  
             TextWrapping="Wrap"
                               Margin="0,2,0,0" />

                    <Separator Margin="0,12,0,8"/>

                    <TextBlock Text="{l:Loc ignoredMods}" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding IgnoredModFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,3" ToolTip="{l:Loc filterTheListOfIgnored2}"/>

                    <ListBox ItemsSource="{Binding FilteredIgnoredMods}" Height="150" HorizontalContentAlignment="Stretch" BorderThickness="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Converter={StaticResource FullPathToFolderNameConverter}}"
                                               ToolTip="{Binding}"
                                               VerticalAlignment="Center"/>

                                    <Button Grid.Column="1"
                                            Content="X"
                                            Command="{Binding DataContext.RemoveIgnoredModCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Foreground="{DynamicResource StatusErrorForeground}"
                                            FontWeight="Bold"
                                            Cursor="Hand"
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Content="{l:Loc addFolderS}"
                            Command="{Binding AddIgnoredModCommand}"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Left"
                            Padding="10,3"
                            ToolTip="{l:Loc selectFolderSTo}"/>
                    <TextBlock Text="{l:Loc modsAddedHereWill}"
                               FontSize="10"
                               Foreground="{DynamicResource HintForeground}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />

                    <Separator Margin="0,12,0,8"/>

                    <!-- Rejected NPCs viewer. Nested rather than a top-level section because it
                         explains the outcome of the mod import the rest of this section configures.
                         Reads the "Rejected NPCs" folder written during mod analysis; the read is
                         deferred until this expander is first opened (see VM_Settings). -->
                    <Expander Header="{l:Loc rejectedNPCs}" Style="{StaticResource SettingsSectionExpander}"
                              Margin="0,0,0,0"
                              IsExpanded="{Binding SectionRejectedNpcs.IsExpanded, Mode=TwoWay}">
                        <StackPanel DataContext="{Binding RejectedNpcs}">
                            <TextBlock TextWrapping="Wrap" FontSize="10"
                                       Foreground="{DynamicResource HintForeground}"
                                       Margin="0,0,0,6"
                                       Text="{l:Loc nPCsThatWereDiscarded}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="{l:Loc refresh}"
                                        Command="{Binding RefreshCommand}"
                                        Padding="10,3"
                                        ToolTip="{l:Loc reReadTheRejected}"/>
                                <Button Content="{l:Loc openFolder}"
                                        Command="{Binding OpenFolderCommand}"
                                        Padding="10,3" Margin="6,0,0,0"
                                        ToolTip="{l:Loc openTheRejectedNPCs}"/>
                                <TextBlock Text="{Binding StatusText}"
                                           VerticalAlignment="Center" Margin="10,0,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource HintForeground}"/>
                            </StackPanel>

                            <TextBox Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                     Margin="0,0,0,3"
                                     ToolTip="{l:Loc filterByModName}"/>

                            <Grid Height="320">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280" MinWidth="140"/>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="*" MinWidth="180"/>
                                </Grid.ColumnDefinitions>

                                <TreeView Grid.Column="0"
                                          ItemsSource="{Binding Groups}"
                                          Background="{DynamicResource TextBoxBackground}"
                                          Foreground="{DynamicResource PrimaryForeground}"
                                          BorderBrush="{DynamicResource BorderBrush}"
                                          BorderThickness="1"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          VirtualizingStackPanel.VirtualizationMode="Standard"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          SelectedItemChanged="RejectedNpcsTree_SelectedItemChanged">
                                    <TreeView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel/>
                                        </ItemsPanelTemplate>
                                    </TreeView.ItemsPanel>
                                    <!-- Declared explicitly rather than as DataType-keyed resources:
                                         the tree is exactly two fixed levels, and naming the
                                         templates outright means the hierarchy (and so each mod
                                         row's expand chevron) never depends on implicit template
                                         lookup succeeding for a recycled container.

                                         Rows ellipsize instead of scrolling sideways: horizontal
                                         scrolling is disabled above because selecting a row raises
                                         BringIntoView, and with mod names wider than this pane that
                                         scrolled the tree right by the width of the chevron column,
                                         putting every expander arrow out of reach. Full text is in
                                         the tooltip and in the detail pane. -->
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Entries}">
                                            <TextBlock Text="{Binding DisplayText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ModName}"/>
                                            <HierarchicalDataTemplate.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayText}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding NpcIdentifier}"/>
                                                </DataTemplate>
                                            </HierarchicalDataTemplate.ItemTemplate>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                    <TreeView.Resources>
                                        <!-- Retemplated here rather than per theme, like the section
                                             Expander above: the default TreeViewItem paints its
                                             selection with SystemColors, which reads as a light-mode
                                             control in the dark themes. Implicit (unkeyed) so it
                                             reaches items at both levels of the tree. -->
                                        <Style TargetType="TreeViewItem">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
                                            <Setter Property="Padding" Value="2,2"/>
                                            <Setter Property="ItemsPanel">
                                                <Setter.Value>
                                                    <ItemsPanelTemplate>
                                                        <VirtualizingStackPanel/>
                                                    </ItemsPanelTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TreeViewItem">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="16"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition/>
                                                            </Grid.RowDefinitions>

                                                            <ToggleButton x:Name="Expander"
                                                                          Grid.Row="0" Grid.Column="0"
                                                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                                          ClickMode="Press" Focusable="False">
                                                                <ToggleButton.Template>
                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                        <Border Background="Transparent" Width="16" Height="16">
                                                                            <Path x:Name="Chevron"
                                                                                  Data="F1 M 0,0 L 5,0 L 2.5,3 Z"
                                                                                  Stretch="Uniform" Width="7" Height="7"
                                                                                  Fill="{DynamicResource PrimaryForeground}"
                                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                  RenderTransformOrigin="0.5,0.5"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsChecked" Value="False">
                                                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                                                    <Setter.Value>
                                                                                        <RotateTransform Angle="-90"/>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </ToggleButton.Template>
                                                            </ToggleButton>

                                                            <Border x:Name="Bd"
                                                                    Grid.Row="0" Grid.Column="1"
                                                                    Background="Transparent"
                                                                    CornerRadius="2"
                                                                    Padding="{TemplateBinding Padding}"
                                                                    SnapsToDevicePixels="True">
                                                                <ContentPresenter x:Name="PART_Header"
                                                                                  ContentSource="Header"
                                                                                  HorizontalAlignment="Left"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>

                                                            <ItemsPresenter x:Name="ItemsHost"
                                                                            Grid.Row="1" Grid.Column="1"/>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsExpanded" Value="False">
                                                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                                            </Trigger>
                                                            <Trigger Property="HasItems" Value="False">
                                                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Bd" Property="Background"
                                                                        Value="{DynamicResource SelectedItemBackground}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TreeView.Resources>
                                </TreeView>

                                <GridSplitter Grid.Column="1" Width="5"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                              Background="Transparent"/>

                                <Border Grid.Column="2"
                                        Background="{DynamicResource TextBoxBackground}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        Padding="8">
                                    <Grid>
                                        <TextBlock Text="{l:Loc selectAModOr}"
                                                   Foreground="{DynamicResource HintForeground}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding HasNoSelection, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel DataContext="{Binding SelectedNode}">
                                                <TextBlock Text="{Binding DetailTitle}"
                                                           FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding DetailSubtitle}"
                                                           Foreground="{DynamicResource HintForeground}"
                                                           TextWrapping="Wrap" Margin="0,2,0,8"/>
                                                <!-- Read-only TextBoxes rather than TextBlocks so the
                                                     reason and the raw log line can be copied out. -->
                                                <TextBox Text="{Binding DetailReason, Mode=OneWay}"
                                                         IsReadOnly="True" TextWrapping="Wrap"
                                                         Background="Transparent" BorderThickness="0" Padding="0"
                                                         Foreground="{DynamicResource PrimaryForeground}"/>
                                                <TextBox Text="{Binding DetailMeta, Mode=OneWay}"
                                                         IsReadOnly="True" TextWrapping="Wrap"
                                                         Background="Transparent" BorderThickness="0" Padding="0"
                                                         Margin="0,10,0,0" FontSize="10"
                                                         Foreground="{DynamicResource HintForeground}"/>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Expander>

            <Expander Header="{l:Loc spawnBatFileOptions}" Style="{StaticResource SettingsSectionExpander}"
                      IsExpanded="{Binding SectionSpawnBatFile.IsExpanded, Mode=TwoWay}">
                <StackPanel>
                    <TextBlock Text="{l:Loc consoleCommandsBeforeSpawning}" Margin="0,0,0,2"/>
                    <TextBox 
                        Text="{Binding BatFilePreCommands, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        Height="80"
                        VerticalScrollBarVisibility="Auto"
                        ToolTip="{l:Loc enterAnyConsoleCommands}"/>

                    <TextBlock Text="{l:Loc consoleCommandsAfterSpawning}" Margin="0,10,0,2"/>
                    <TextBox 
                        Text="{Binding BatFilePostCommands, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        Height="80"
                        VerticalScrollBarVisibility="Auto"
                        ToolTip="{l:Loc enterAnyConsole}"/>
                </StackPanel>
            </Expander>
            
            <Expander Header="{l:Loc logging}" Style="{StaticResource SettingsSectionExpander}"
                      IsExpanded="{Binding SectionLogging.IsExpanded, Mode=TwoWay}">
                <StackPanel>
                    <CheckBox Content="{l:Loc logActivity}"
                              IsChecked="{Binding LogActivity, Mode=TwoWay}"
                              ToolTip="{l:Loc enablesDetailedLoggingOf}"/>
                    <CheckBox Content="{l:Loc logStartup}"
                              IsChecked="{Binding LogStartup, Mode=TwoWay}"
                              Margin="0,5,0,0"
                              ToolTip="{l:Loc logsDetailedStartupOperations}"/>
                    <CheckBox Content="{l:Loc logRecordProvenance}"
                              IsChecked="{Binding LogRecordProvenance, Mode=TwoWay}"
                              Margin="0,5,0,0"
                              ToolTip="{l:Loc whenOnAPatch}"/>
                    <CheckBox Content="{l:Loc logAssetProvenance}"
                              IsChecked="{Binding LogAssetProvenance, Mode=TwoWay}"
                              Margin="0,5,0,0"
                              ToolTip="{l:Loc whenOnA}"/>

                    <Separator Margin="0,10,0,8"/>

                    <TextBlock Text="{l:Loc perNPCPatchValidation}" FontWeight="Bold"/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.8" Margin="0,2,0,6"
                               Text="{l:Loc forEachNPCIn}"/>

                    <TextBox Text="{Binding NpcLogSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{l:Loc typeToSearchNPCs}"/>

                    <!-- Clickable search matches -->
                    <ListBox ItemsSource="{Binding NpcLogSearchResults}"
                             Visibility="{Binding HasNpcLogSearchResults, Converter={StaticResource BooleanToVisibilityConverter}}"
                             MaxHeight="160" HorizontalContentAlignment="Stretch"
                             BorderThickness="1" Margin="0,2,0,0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button HorizontalContentAlignment="Left"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Padding="2,1"
                                        Command="{Binding DataContext.AddNpcToLogCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{l:Loc clickToAddThis}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Editable list of NPCs to log -->
                    <ListBox ItemsSource="{Binding LoggedNpcs}" Height="150" Margin="0,6,0,0"
                             HorizontalContentAlignment="Stretch" BorderThickness="1"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center">
                                        <TextBlock.ToolTip>
                                            <ToolTip>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding NpcName}"/>
                                                    <TextBlock Text="{Binding NpcEditorId}"/>
                                                    <TextBlock Text="{Binding NpcFormKeyString}"/>
                                                </StackPanel>
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                    </TextBlock>

                                    <Button Grid.Column="1"
                                            Content="X"
                                            Command="{Binding DataContext.RemoveNpcFromLogCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Foreground="{DynamicResource StatusErrorForeground}"
                                            FontWeight="Bold"
                                            Cursor="Hand"
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            ToolTip="{l:Loc removeThisNPCFrom}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</reactiveui:ReactiveUserControl>