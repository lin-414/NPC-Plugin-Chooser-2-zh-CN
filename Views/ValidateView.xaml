<!-- ValidateView.xaml -->
<reactiveui:ReactiveUserControl x:Class="NPC_Plugin_Chooser_2.Views.ValidateView"
                                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                xmlns:l="clr-namespace:NPC_Plugin_Chooser_2.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                                xmlns:vm="clr-namespace:NPC_Plugin_Chooser_2.View_Models"
                                xmlns:reactiveui="http://reactiveui.net"
                                mc:Ignorable="d"
                                x:TypeArguments="vm:VM_Validate"
                                d:DataContext="{d:DesignInstance Type=vm:VM_Validate}"
                                d:DesignHeight="550" d:DesignWidth="800">

    <Grid Margin="10">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
            <Button x:Name="ValidateOutputButton"
                    Content="{l:Loc validateOutput}"
                    Command="{Binding ValidateOutputCommand}"
                    MinWidth="150" Padding="10,5"
                    VerticalAlignment="Center"
                    ToolTip="{l:Loc checksThatYourGenerated}"/>

            <Button x:Name="AnalyzeMastersButton"
                    Content="{l:Loc analyzeMasters}"
                    Command="{Binding AnalyzeMastersCommand}"
                    Margin="15,0,0,0" Padding="10,5"
                    VerticalAlignment="Center"
                    ToolTip="{l:Loc analyzeWhySpecificMasters}"/>
        </StackPanel>
    </Grid>
</reactiveui:ReactiveUserControl>
