<reactiveui:ReactiveWindow x:Class="NPC_Plugin_Chooser_2.Views.OverrideRootSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NPC_Plugin_Chooser_2.Views"
        xmlns:vm="clr-namespace:NPC_Plugin_Chooser_2.View_Models"
        xmlns:themes="clr-namespace:NPC_Plugin_Chooser_2.Themes"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:reactiveui="http://reactiveui.net"
             xmlns:l="clr-namespace:NPC_Plugin_Chooser_2.Localization"
        mc:Ignorable="d"
        x:TypeArguments="vm:VM_OverrideRootSelector"
        Style="{DynamicResource ThemedWindowStyle}"
        Title="{l:Loc overrideRoots}" Height="620" Width="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <i:Interaction.Behaviors>
        <themes:TitleBarThemingBehavior />
    </i:Interaction.Behaviors>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock TextWrapping="Wrap">
                <Run Text="{l:Loc whichFieldsOfAn}"/>
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Opacity="0.8" Margin="0,6,0,0"
                                   Text="{l:Loc aTickedFieldIs}"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Fields}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:VM_SelectableRootField}">
                            <CheckBox IsChecked="{Binding IsSelected}"
                                      ToolTip="{Binding ToolTip}"
                                      Margin="8,3"
                                      VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <!-- The appearance set reads as the "normal" choice; everything
                                                     else is dimmed so an opted-in extra stands out. -->
                                                <DataTrigger Binding="{Binding IsAppearanceDefault}" Value="False">
                                                    <Setter Property="Opacity" Value="0.75"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding SummaryText}" Margin="2,8,0,0" Opacity="0.9" TextWrapping="Wrap"/>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="{l:Loc resetToDefaults}" Padding="8,2" Command="{Binding ResetToDefaultsCommand}"/>
                <Button Content="{l:Loc checkAll}" Padding="8,2" Margin="5,0,0,0" Command="{Binding CheckAllCommand}"/>
                <Button Content="{l:Loc uncheckAll}" Padding="8,2" Margin="5,0,0,0" Command="{Binding UncheckAllCommand}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{l:Loc ok}" Width="80" IsDefault="True" Command="{Binding OKCommand}"/>
                <Button Content="{l:Loc cancel}" Width="80" Margin="5,0,0,0" IsCancel="True" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</reactiveui:ReactiveWindow>
