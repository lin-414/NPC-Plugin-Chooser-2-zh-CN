<reactiveui:ReactiveWindow x:Class="NPC_Plugin_Chooser_2.Views.ResourcePluginSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NPC_Plugin_Chooser_2.Views"
        xmlns:vm="clr-namespace:NPC_Plugin_Chooser_2.View_Models"
        xmlns:themes="clr-namespace:NPC_Plugin_Chooser_2.Themes"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:reactiveui="http://reactiveui.net"
             xmlns:l="clr-namespace:NPC_Plugin_Chooser_2.Localization"
        mc:Ignorable="d"
        x:TypeArguments="vm:VM_ResourcePluginSelector"
        Style="{DynamicResource ThemedWindowStyle}"
        Title="{l:Loc setResourceOnlyPlugins}" Height="450" Width="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <i:Interaction.Behaviors>
        <themes:TitleBarThemingBehavior />
    </i:Interaction.Behaviors>
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock TextWrapping="Wrap"
                                       Text="{l:Loc selectThePluginsThat}"/>
            <TextBlock TextWrapping="Wrap" Opacity="0.8" Margin="0,6,0,0"
                                       Text="{l:Loc mergeInControlsWhether}"/>
        </StackPanel>

        <!-- Column headers, kept in the same 3-column grid as the rows below so they line up. -->
        <Grid Grid.Row="1" Margin="5,0,5,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="{l:Loc resourceOnlyPlugin}" FontWeight="Bold"/>
            <TextBlock Grid.Column="2" Text="{l:Loc merge}" FontWeight="Bold" Margin="10,0,0,0"/>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderBrush="Gray" BorderThickness="1">
            <ItemsControl ItemsSource="{Binding SelectablePlugins}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:VM_SelectableMod}">
                        <Grid Margin="5,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" Grid.ColumnSpan="2"
                                      IsChecked="{Binding IsSelected}"
                                      Content="{Binding DisplayText}"
                                      VerticalAlignment="Center"/>

                            <!-- Disabled for non-resource plugins: they mirror the mod's own toggle. -->
                            <CheckBox Grid.Column="2"
                                      IsChecked="{Binding IsMergedIn}"
                                      IsEnabled="{Binding IsMergeEditable}"
                                      ToolTip="{Binding MergeInToolTip}"
                                      ToolTipService.ShowOnDisabled="True"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="10,0,24,0"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{l:Loc ok}" Width="80" IsDefault="True"
                    Command="{Binding OKCommand}"/>
            <Button Content="{l:Loc cancel}" Width="80" Margin="5,0,0,0" IsCancel="True"
                    Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</reactiveui:ReactiveWindow>