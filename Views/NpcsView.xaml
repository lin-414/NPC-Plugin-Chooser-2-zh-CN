<!-- NpcsView.xaml -->
<reactiveui:ReactiveUserControl x:Class="NPC_Plugin_Chooser_2.Views.NpcsView"
             x:Name="NpcsViewRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:NPC_Plugin_Chooser_2.Views"
             xmlns:vm="clr-namespace:NPC_Plugin_Chooser_2.View_Models"
             xmlns:reactiveui="http://reactiveui.net"
             xmlns:System="clr-namespace:System;assembly=mscorlib"
             xmlns:dd="urn:gong-wpf-dragdrop"
             xmlns:models="clr-namespace:NPC_Plugin_Chooser_2.Models"
             xmlns:l="clr-namespace:NPC_Plugin_Chooser_2.Localization"
             mc:Ignorable="d"
             x:TypeArguments="vm:VM_NpcSelectionBar"
             d:DataContext="{d:DesignInstance Type=vm:VM_NpcSelectionBar}"
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <local:BooleanToBrushConverter x:Key="BooleanToBrushConverter"/>
        <local:EnumMatchToBooleanConverter x:Key="EnumMatchToBooleanConverter"/>
        <local:IsNotNullConverter x:Key="IsNotNullConverter"/>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:EnumDescriptionConverter x:Key="EnumDescConverter"/>
        <local:PercentageSizingConverter x:Key="PercentageSizingConverter"/>
        <local:LineOffsetConverter x:Key="LineOffsetConverter"/>
        <local:ModKeyToStringConverter x:Key="ModKeyToStringConverter"/>
        <local:AreModKeysEqualMultiConverter x:Key="AreModKeysEqualMultiConverter"/>
        <local:TupleConverter x:Key="TupleConverter"/>
        <local:OutfitOverrideStateConverter x:Key="OutfitOverrideStateConverter"/>
        <local:IsGreaterThanOneConverter x:Key="IsGreaterThanOneConverter"/>
        <local:PathToFolderNameConverter x:Key="PathToFolderNameConverter"/>
        <local:FilterInversionToBooleanConverter x:Key="FilterInversionConverter"/>

        <!-- Collapsible settings-bar group boxes. The GroupBox chrome is left entirely to
             the active theme; collapsing zeroes BorderThickness/Padding so only the
             clickable caption remains. Bound per-GroupBox rather than via a Style with
             BasedOn, because ThemeManager swaps the theme dictionary at runtime and a
             StaticResource BasedOn would freeze the template to the startup theme. -->
        <local:BooleanToThicknessConverter x:Key="GroupBorderThicknessConverter"
                                           TrueThickness="1" FalseThickness="0"/>
        <local:BooleanToThicknessConverter x:Key="GroupPaddingConverter"
                                           TrueThickness="2" FalseThickness="0"/>

        <!-- Rendered by the stock GroupBox template (Dark/Light) and the custom one
             (GitHub Light / Tokyo Night) alike, since both present the header through a
             ContentPresenter with ContentSource="Header". Deliberately sets no font
             properties, so each theme's own caption styling still applies and the header
             looks exactly as it did before it became clickable. -->
        <DataTemplate x:Key="CollapsibleGroupHeader" DataType="{x:Type vm:VM_CollapsibleGroup}">
            <StackPanel Orientation="Horizontal"
                        Background="Transparent"
                        Cursor="Hand"
                        ToolTip="{l:Loc clickToShowOr}">
                <StackPanel.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleCommand}"/>
                </StackPanel.InputBindings>
                <!-- A vector chevron rather than a glyph: Segoe UI has no matched pair of
                     triangles (U+25BC exists, U+25B6 does not), so text would font-fall-back.
                     Fill tracks the caption's Foreground, keeping it correct per theme and
                     through runtime theme swaps. -->
                <Path x:Name="Chevron"
                      Data="F1 M 0,0 L 5,0 L 2.5,3 Z"
                      Stretch="Uniform" Width="7" Height="7"
                      Fill="{Binding Foreground, ElementName=GroupCaption}"
                      VerticalAlignment="Center" Margin="0,0,5,0"
                      RenderTransformOrigin="0.5,0.5"/>
                <TextBlock x:Name="GroupCaption" Text="{Binding Title}" VerticalAlignment="Center"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                    <Setter TargetName="Chevron" Property="RenderTransform">
                        <Setter.Value>
                            <RotateTransform Angle="-90"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <ObjectDataProvider x:Key="OutfitOverrideEnumValues" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:OutfitOverride"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="NpcSearchTypeEnumValues" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
            <ObjectDataProvider.MethodParameters> <x:Type TypeName="vm:NpcSearchType"/> </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
         <ObjectDataProvider x:Key="SelectionStateFilterTypeEnumValues" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
             <ObjectDataProvider.MethodParameters> <x:Type TypeName="vm:SelectionStateFilterType"/> </ObjectDataProvider.MethodParameters>
         </ObjectDataProvider>
        <ObjectDataProvider x:Key="ShareStatusFilterTypeEnumValues" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="vm:ShareStatusFilterType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="UniquenessFilterTypeEnumValues" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="vm:UniquenessFilterType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="GenderFilterTypeEnumValues" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="vm:GenderFilterType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="TemplateFilterTypeEnumValues" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="vm:TemplateFilterType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="NpcSortPropertyEnumValues" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="vm:NpcSortProperty"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <DataTemplate x:Key="AppearanceModDragAdorner" DataType="{x:Type vm:VM_NpcsMenuMugshot}">
            <Border BorderThickness="1" BorderBrush="DimGray" Background="LightGoldenrodYellow"
                    Opacity="0.75" CornerRadius="2" Padding="2"
                    Width="100" Height="100">
                <Grid>
                    <Image Source="{Binding MugshotSource}" Stretch="UniformToFill" />
                    <TextBlock Text="{Binding ModName}" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                               Background="{DynamicResource MugshotCaptionBackground}" 
                               Foreground="{DynamicResource MugshotCaptionForeground}" 
                               FontSize="10" Padding="3,1"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding ModName}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- DataContext Proxy Element -->
        <!-- Bind its DataContext to the DataContext of the UserControl itself -->
        <FrameworkElement x:Key="DataContextProxy" Visibility="Collapsed"/>

        <!-- Define the ContextMenu as a resource, using the Proxy -->
        <ContextMenu x:Key="HideUnhideContextMenuResource">
            <MenuItem Header="{l:Loc hideAllSelected}"
                      Command="{Binding Path=DataContext.HideAllSelectedCommand, Source={StaticResource DataContextProxy}}" />
            <MenuItem Header="{l:Loc hideAllButSelected}"
                      Command="{Binding Path=DataContext.HideAllButSelectedCommand, Source={StaticResource DataContextProxy}}" />
            <Separator />
            <MenuItem Header="{l:Loc unhideAllSelected}"
                      Command="{Binding Path=DataContext.UnhideAllSelectedCommand, Source={StaticResource DataContextProxy}}" />
            <MenuItem Header="{l:Loc unhideAllButSelected}"
                      Command="{Binding Path=DataContext.UnhideAllButSelectedCommand, Source={StaticResource DataContextProxy}}" />
        </ContextMenu>
    
    </UserControl.Resources>

    <!-- Navigation shortcuts (Alt+Arrow) are handled via PreviewKeyDown in code-behind
         so they work even when the ListBox has focus and would otherwise consume arrow keys. -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Settings Row (Grid.Row="0") -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="5">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <GroupBox Header="{Binding GroupNpcGroups}" HeaderTemplate="{StaticResource CollapsibleGroupHeader}"
                          VerticalAlignment="Center" Margin="0,2,5,2"
                          BorderThickness="{Binding GroupNpcGroups.IsExpanded, Converter={StaticResource GroupBorderThicknessConverter}}"
                          Padding="{Binding GroupNpcGroups.IsExpanded, Converter={StaticResource GroupPaddingConverter}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,2"
                                Visibility="{Binding GroupNpcGroups.IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{l:Loc group}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox MinWidth="120" MaxWidth="200" Margin="0,0,5,0" VerticalAlignment="Center"
                                  IsEditable="True"
                                  ItemsSource="{Binding AvailableNpcGroups}"
                                  Text="{Binding SelectedGroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="{l:Loc selectOrType}"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
                            <Button x:Name="AddCurrentNpcButton" Content="{l:Loc add}" Padding="3,1" Margin="0,0,1,0" Command="{Binding AddCurrentNpcToGroupCommand}" ToolTip="{l:Loc addTheCurrentlySelected}"/>
                            <Button x:Name="RemoveCurrentNpcButton" Content="{l:Loc remove}" Padding="3,1" Margin="0,0,2,0" Command="{Binding RemoveCurrentNpcFromGroupCommand}" ToolTip="{l:Loc removeTheCurrentlySelected}"/>
                            <TextBlock Text="{l:Loc current}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
                            <Button x:Name="AddVisibleNpcsButton" Content="{l:Loc add}" Padding="3,1" Margin="0,0,1,0" Command="{Binding AddAllVisibleNpcsToGroupCommand}" ToolTip="{l:Loc addAllNPCsCurrently}"/>
                            <Button x:Name="RemoveVisibleNpcsButton" Content="{l:Loc remove}" Padding="3,1" Margin="0,0,2,0" Command="{Binding RemoveAllVisibleNpcsFromGroupCommand}" ToolTip="{l:Loc removeAllNPCsCurrently}"/>
                            <TextBlock Text="{l:Loc visible}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
                
                <GroupBox Header="{Binding GroupShow}" HeaderTemplate="{StaticResource CollapsibleGroupHeader}"
                          VerticalAlignment="Center" Margin="5,2,5,2"
                          BorderThickness="{Binding GroupShow.IsExpanded, Converter={StaticResource GroupBorderThicknessConverter}}"
                          Padding="{Binding GroupShow.IsExpanded, Converter={StaticResource GroupPaddingConverter}}">
                    <StackPanel Orientation="Horizontal" MinHeight="26"
                                Visibility="{Binding GroupShow.IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <CheckBox Content="{l:Loc singleOptionNPCs}" Margin="3,2,3,2" IsChecked="{Binding ShowSingleOptionNpcs, Mode=TwoWay}" VerticalAlignment="Center" ToolTip="{l:Loc ifUncheckedHidesNPCs}"/>
                        <CheckBox Content="{l:Loc unloadedNPCs}" Margin="3,2,3,2" IsChecked="{Binding ShowUnloadedNpcs, Mode=TwoWay}" VerticalAlignment="Center" ToolTip="{l:Loc ifUncheckedHides}"/>
                        <CheckBox Content="{l:Loc skyPatcherTemplates}" Margin="3,2,3,2" IsChecked="{Binding ShowSkyPatcherTemplates, Mode=TwoWay}" VerticalAlignment="Center" ToolTip="{l:Loc ifUncheckedHidesDummy}"/>
                        <CheckBox Content="{l:Loc hiddenMods}" Margin="3,2, 3, 2" IsChecked="{Binding ShowHiddenMods, Mode=TwoWay}" VerticalAlignment="Center" ToolTip="{l:Loc toggleVisibilityOfHidden}"/>
                        <CheckBox Content="{l:Loc uninstalledMods}" Margin="3,2,3,2" IsChecked="{Binding ShowUninstalledMods, Mode=TwoWay}" VerticalAlignment="Center" ToolTip="{l:Loc ifUncheckedHidesMugshot}"/>
                        <CheckBox Content="{l:Loc nPCDescriptions}" Margin="3,2,3,2" IsChecked="{Binding ShowNpcDescriptions, Mode=TwoWay}" VerticalAlignment="Center" ToolTip="{l:Loc ifCheckedShowsDescriptions}"/>
                    </StackPanel>
                </GroupBox>
                
                <GroupBox Header="{Binding GroupAppearanceSelections}" HeaderTemplate="{StaticResource CollapsibleGroupHeader}"
                          VerticalAlignment="Center" Margin="5,2,5,2"
                          BorderThickness="{Binding GroupAppearanceSelections.IsExpanded, Converter={StaticResource GroupBorderThicknessConverter}}"
                          Padding="{Binding GroupAppearanceSelections.IsExpanded, Converter={StaticResource GroupPaddingConverter}}">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding GroupAppearanceSelections.IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Content="{l:Loc matchLoadOrder}" Margin="0,2,5,2" Padding="5,2" VerticalAlignment="Center"
                                Command="{Binding ImportChoicesFromLoadOrderCommand}" ToolTip="{l:Loc automaticallySelectAppearanceMods}"/>
                        <Button Content="{l:Loc randomize}" Margin="0,2,5,2" Padding="5,2" VerticalAlignment="Center"
                                Command="{Binding RandomizeChoicesCommand}" ToolTip="{l:Loc openTheRandomizeDialog}"/>
                        <Button Content="{l:Loc export}" Margin="0,2,5,2" Padding="5,2" VerticalAlignment="Center"
                                Command="{Binding ExportChoicesCommand}" ToolTip="{l:Loc exportTheCurrentList}"/>
                        <Button Content="{l:Loc import}" Margin="0,2,5,2" Padding="5,2" VerticalAlignment="Center"
                                Command="{Binding ImportChoicesCommand}" ToolTip="{l:Loc importAListOf}"/>
                        <Button Content="{l:Loc clear}" Margin="0,2,0,2" Padding="5,2" VerticalAlignment="Center"
                                Command="{Binding ClearChoicesCommand}" ToolTip="{l:Loc clearAllSelectionsYou}"/>
                    </StackPanel>
                </GroupBox>
                
                <GroupBox Header="{Binding GroupSelectedMugshots}" HeaderTemplate="{StaticResource CollapsibleGroupHeader}"
                          VerticalAlignment="Center" Margin="5,2,5,2"
                          BorderThickness="{Binding GroupSelectedMugshots.IsExpanded, Converter={StaticResource GroupBorderThicknessConverter}}"
                          Padding="{Binding GroupSelectedMugshots.IsExpanded, Converter={StaticResource GroupPaddingConverter}}">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding GroupSelectedMugshots.IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Content="{l:Loc compare}" Margin="0,2,5,2" Padding="5,2" VerticalAlignment="Center"
                                Command="{Binding CompareSelectedCommand}"
                                ToolTip="{l:Loc compareAllCheckedMugshots}"/>
                        <Button Content="{l:Loc hideUnhide}" Margin="0,2,5,2" Padding="5,2" VerticalAlignment="Center"
                                ContextMenu="{StaticResource HideUnhideContextMenuResource}"
                                Click="HideUnhideButton_Click"
                                IsEnabled="{Binding CanOpenHideUnhideMenu}"
                                ToolTip="{l:Loc hideOrUnhideMugshots}"/>
                        <Button Content="{l:Loc deselect}" Margin="0,2,5,2" Padding="5,2" VerticalAlignment="Center"
                                Command="{Binding DeselectAllCommand}"
                                ToolTip="{l:Loc uncheckAllMugshotsFor}"/>
                        <Button Content="{Binding LiveTileToggleLabel}" Margin="0,2,0,2" Padding="5,2" VerticalAlignment="Center"
                                Command="{Binding ToggleLiveTilesForCheckedCommand}"
                                ToolTip="{l:Loc toggleLiveTileTooltip}"/>
                        </StackPanel>
                </GroupBox>
                
                <GroupBox Header="{Binding GroupSubmenus}" HeaderTemplate="{StaticResource CollapsibleGroupHeader}"
                          VerticalAlignment="Center" Margin="5,2,5,2"
                          BorderThickness="{Binding GroupSubmenus.IsExpanded, Converter={StaticResource GroupBorderThicknessConverter}}"
                          Padding="{Binding GroupSubmenus.IsExpanded, Converter={StaticResource GroupPaddingConverter}}">
                    <Button Content="{l:Loc favorites}" Padding="5,2" VerticalAlignment="Center" Command="{Binding ShowFavoritesCommand}"
                            Visibility="{Binding GroupSubmenus.IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="{l:Loc addAnAppearanceFrom}"/>
                </GroupBox>
            </WrapPanel>
        </Border>

        <!-- Main Content Row (Grid.Row="1") -->
        <Grid Grid.Row="1" x:Name="MainContentGridForSplitter">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="200" x:Name="NpcListColumn"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="250" x:Name="NpcDisplayColumn" />
            </Grid.ColumnDefinitions>

            <!-- Left Column: Search + NPC List -->
            <DockPanel Grid.Column="0" LastChildFill="True">
                <Border DockPanel.Dock="Top" BorderThickness="0,0,1,1" BorderBrush="{DynamicResource BorderBrush}" Padding="5">
                    <StackPanel Orientation="Vertical">
                        <!-- Search Term 1 -->
                        <Grid Margin="0,0,0,5">
                           <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                           <CheckBox Grid.Column="0" Content="{l:Loc not}" Margin="0,0,5,0" VerticalAlignment="Center" IsChecked="{Binding SearchInversion1, Mode=TwoWay, Converter={StaticResource FilterInversionConverter}}" ToolTip="{l:Loc uncheckedKeepNPCsMatching}"/>
                           <ComboBox Grid.Column="1" MinWidth="80" Margin="0,0,3,0" VerticalAlignment="Center" ItemsSource="{Binding Source={StaticResource NpcSearchTypeEnumValues}}" SelectedItem="{Binding SearchType1, Mode=TwoWay}" ToolTip="{l:Loc selectSearchField1}">
                               <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDescConverter}}"/></DataTemplate></ComboBox.ItemTemplate>
                           </ComboBox>
                           <Grid Grid.Column="2">
                               <TextBox VerticalAlignment="Center" Text="{Binding SearchText1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:Loc enterSearchTerm1}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelectionStateSearch1}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger><DataTrigger Binding="{Binding IsGroupSearch1}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsShareStatusSearch1}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsUniquenessSearch1}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsGenderSearch1}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsRaceSearch1}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsTemplateSearch1}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                               </TextBox>
                               <ComboBox VerticalAlignment="Center" ItemsSource="{Binding Source={StaticResource SelectionStateFilterTypeEnumValues}}" SelectedItem="{Binding SelectedStateFilter1, Mode=TwoWay}" ToolTip="{l:Loc filterBySelectionState}" Visibility="{Binding IsSelectionStateSearch1, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDescConverter}}"/></DataTemplate></ComboBox.ItemTemplate>
                               </ComboBox>
                               <ComboBox VerticalAlignment="Center" ItemsSource="{Binding Source={StaticResource ShareStatusFilterTypeEnumValues}}" SelectedItem="{Binding SelectedShareStatusFilter1, Mode=TwoWay}" ToolTip="{l:Loc filterByGuestStatus}" Visibility="{Binding IsShareStatusSearch1, Converter={StaticResource BooleanToVisibilityConverter}}">
                                   <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDescConverter}}"/></DataTemplate></ComboBox.ItemTemplate>
                               </ComboBox>
                               <ComboBox VerticalAlignment="Center" ItemsSource="{Binding Source={StaticResource UniquenessFilterTypeEnumValues}}" SelectedItem="{Binding SelectedUniquenessFilter1, Mode=TwoWay}" ToolTip="{l:Loc filterByUniqueness}" Visibility="{Binding IsUniquenessSearch1, Converter={StaticResource BooleanToVisibilityConverter}}">
                                   <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}"/></DataTemplate></ComboBox.ItemTemplate>
                               </ComboBox>
                               <ComboBox VerticalAlignment="Center" ItemsSource="{Binding Source={StaticResource GenderFilterTypeEnumValues}}" SelectedItem="{Binding SelectedGenderFilter1, Mode=TwoWay}" ToolTip="{l:Loc filterByGender}" Visibility="{Binding IsGenderSearch1, Converter={StaticResource BooleanToVisibilityConverter}}">
                                   <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}"/></DataTemplate></ComboBox.ItemTemplate>
                               </ComboBox>
                               <ComboBox VerticalAlignment="Center" ItemsSource="{Binding Source={StaticResource TemplateFilterTypeEnumValues}}" SelectedItem="{Binding SelectedTemplateFilter1, Mode=TwoWay}" ToolTip="{l:Loc filterByTemplateStatus}" Visibility="{Binding IsTemplateSearch1, Converter={StaticResource BooleanToVisibilityConverter}}">
                                   <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDescConverter}}"/></DataTemplate></ComboBox.ItemTemplate>
                               </ComboBox>
                               <ComboBox VerticalAlignment="Center" ItemsSource="{Binding AvailableNpcGroups}" SelectedItem="{Binding SelectedGroupFilter1, Mode=TwoWay}" ToolTip="{l:Loc selectGroupToFilter}" Visibility="{Binding IsGroupSearch1, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                               <ComboBox VerticalAlignment="Center" IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding AvailableRaces}" Text="{Binding SearchText1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:Loc filterByRaceName}" Visibility="{Binding IsRaceSearch1, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                           </Grid>
                        </Grid>
                        <!-- Search Term 2 -->
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Content="{l:Loc not}" Margin="0,0,5,0" VerticalAlignment="Center" IsChecked="{Binding SearchInversion2, Mode=TwoWay, Converter={StaticResource FilterInversionConverter}}" ToolTip="{l:Loc uncheckedKeepNPCsMatching}"/>
                            <ComboBox Grid.Column="1" MinWidth="80" Margin="0,0,3,0" VerticalAlignment="Center" ItemsSource="{Binding Source={StaticResource NpcSearchTypeEnumValues}}" SelectedItem="{Binding SearchType2, Mode=TwoWay}" ToolTip="{l:Loc selectSearchField2}">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDescConverter}}"/></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            <Grid Grid.Column="2">
                                <TextBox VerticalAlignment="Center" Text="{Binding SearchText2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:Loc enterSearchTerm2}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelectionStateSearch2}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsGroupSearch2}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsShareStatusSearch2}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsUniquenessSearch2}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsGenderSearch2}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsRaceSearch2}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsTemplateSearch2}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <ComboBox VerticalAlignment="Center" ItemsSource="{Binding Source={StaticResource SelectionStateFilterTypeEnumValues}}" SelectedItem="{Binding SelectedStateFilter2, Mode=TwoWay}" ToolTip="{l:Loc filterBySelectionState}" Visibility="{Binding IsSelectionStateSearch2, Converter={StaticResource BooleanToVisibilityConverter}}">
                                     <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDescConverter}}"/></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <ComboBox VerticalAlignment="Center" ItemsSource="{Binding Source={StaticResource ShareStatusFilterTypeEnumValues}}" SelectedItem="{Binding SelectedShareStatusFilter2, Mode=TwoWay}" ToolTip="{l:Loc filterByGuestStatus}" Visibility="{Binding IsShareStatusSearch2, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDescConverter}}"/></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <ComboBox VerticalAlignment="Center" ItemsSource="{Binding Source={StaticResource UniquenessFilterTypeEnumValues}}" SelectedItem="{Binding SelectedUniquenessFilter2, Mode=TwoWay}" ToolTip="{l:Loc filterByUniqueness}" Visibility="{Binding IsUniquenessSearch2, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}"/></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <ComboBox VerticalAlignment="Center" ItemsSource="{Binding Source={StaticResource GenderFilterTypeEnumValues}}" SelectedItem="{Binding SelectedGenderFilter2, Mode=TwoWay}" ToolTip="{l:Loc filterByGender}" Visibility="{Binding IsGenderSearch2, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}"/></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <ComboBox VerticalAlignment="Center" ItemsSource="{Binding Source={StaticResource TemplateFilterTypeEnumValues}}" SelectedItem="{Binding SelectedTemplateFilter2, Mode=TwoWay}" ToolTip="{l:Loc filterByTemplateStatus}" Visibility="{Binding IsTemplateSearch2, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDescConverter}}"/></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <ComboBox VerticalAlignment="Center" ItemsSource="{Binding AvailableNpcGroups}" SelectedItem="{Binding SelectedGroupFilter2, Mode=TwoWay}" ToolTip="{l:Loc selectGroupToFilterBy}" Visibility="{Binding IsGroupSearch2, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <ComboBox VerticalAlignment="Center" IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding AvailableRaces}" Text="{Binding SearchText2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:Loc filterByRaceTip}" Visibility="{Binding IsRaceSearch2, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                           </Grid>
                        </Grid>
                        <!-- Search Term 3 -->
                        <Grid Margin="0,0,0,5">
                             <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                             <CheckBox Grid.Column="0" Content="{l:Loc not}" Margin="0,0,5,0" VerticalAlignment="Center" IsChecked="{Binding SearchInversion3, Mode=TwoWay, Converter={StaticResource FilterInversionConverter}}" ToolTip="{l:Loc uncheckedKeepNPCsMatching}"/>
                             <ComboBox Grid.Column="1" MinWidth="80" Margin="0,0,3,0" VerticalAlignment="Center" ItemsSource="{Binding Source={StaticResource NpcSearchTypeEnumValues}}" SelectedItem="{Binding SearchType3, Mode=TwoWay}" ToolTip="{l:Loc selectSearchField3}">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDescConverter}}"/></DataTemplate></ComboBox.ItemTemplate>
                             </ComboBox>
                              <Grid Grid.Column="2">
                                 <TextBox VerticalAlignment="Center" Text="{Binding SearchText3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:Loc enterSearchTerm3}">
                                     <TextBox.Style>
                                         <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                             <Setter Property="Visibility" Value="Visible"/>
                                             <Style.Triggers>
                                                 <DataTrigger Binding="{Binding IsSelectionStateSearch3}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                 </DataTrigger>
                                                 <DataTrigger Binding="{Binding IsGroupSearch3}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                 <DataTrigger Binding="{Binding IsShareStatusSearch3}" Value="True">
                                                     <Setter Property="Visibility" Value="Collapsed"/>
                                                 </DataTrigger>
                                                 <DataTrigger Binding="{Binding IsUniquenessSearch3}" Value="True">
                                                     <Setter Property="Visibility" Value="Collapsed"/>
                                                 </DataTrigger>
                                                 <DataTrigger Binding="{Binding IsGenderSearch3}" Value="True">
                                                     <Setter Property="Visibility" Value="Collapsed"/>
                                                 </DataTrigger>
                                                 <DataTrigger Binding="{Binding IsRaceSearch3}" Value="True">
                                                     <Setter Property="Visibility" Value="Collapsed"/>
                                                 </DataTrigger>
                                                 <DataTrigger Binding="{Binding IsTemplateSearch3}" Value="True">
                                                     <Setter Property="Visibility" Value="Collapsed"/>
                                                 </DataTrigger>
                                             </Style.Triggers>
                                         </Style>
                                     </TextBox.Style>
                                 </TextBox>
                                 <ComboBox VerticalAlignment="Center" ItemsSource="{Binding Source={StaticResource SelectionStateFilterTypeEnumValues}}" SelectedItem="{Binding SelectedStateFilter3, Mode=TwoWay}" ToolTip="{l:Loc filterBySelectionState}" Visibility="{Binding IsSelectionStateSearch3, Converter={StaticResource BooleanToVisibilityConverter}}">
                                      <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDescConverter}}"/></DataTemplate></ComboBox.ItemTemplate>
                                 </ComboBox>
                                  <ComboBox VerticalAlignment="Center" ItemsSource="{Binding Source={StaticResource ShareStatusFilterTypeEnumValues}}" SelectedItem="{Binding SelectedShareStatusFilter3, Mode=TwoWay}" ToolTip="{l:Loc filterByGuestStatus}" Visibility="{Binding IsShareStatusSearch3, Converter={StaticResource BooleanToVisibilityConverter}}">
                                      <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDescConverter}}"/></DataTemplate></ComboBox.ItemTemplate>
                                  </ComboBox>
                                  <ComboBox VerticalAlignment="Center" ItemsSource="{Binding Source={StaticResource UniquenessFilterTypeEnumValues}}" SelectedItem="{Binding SelectedUniquenessFilter3, Mode=TwoWay}" ToolTip="{l:Loc filterByUniqueness}" Visibility="{Binding IsUniquenessSearch3, Converter={StaticResource BooleanToVisibilityConverter}}">
                                      <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}"/></DataTemplate></ComboBox.ItemTemplate>
                                  </ComboBox>
                                  <ComboBox VerticalAlignment="Center" ItemsSource="{Binding Source={StaticResource GenderFilterTypeEnumValues}}" SelectedItem="{Binding SelectedGenderFilter3, Mode=TwoWay}" ToolTip="{l:Loc filterByGender}" Visibility="{Binding IsGenderSearch3, Converter={StaticResource BooleanToVisibilityConverter}}">
                                      <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}"/></DataTemplate></ComboBox.ItemTemplate>
                                  </ComboBox>
                                  <ComboBox VerticalAlignment="Center" ItemsSource="{Binding Source={StaticResource TemplateFilterTypeEnumValues}}" SelectedItem="{Binding SelectedTemplateFilter3, Mode=TwoWay}" ToolTip="{l:Loc filterByTemplateStatus}" Visibility="{Binding IsTemplateSearch3, Converter={StaticResource BooleanToVisibilityConverter}}">
                                      <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDescConverter}}"/></DataTemplate></ComboBox.ItemTemplate>
                                  </ComboBox>
                                 <ComboBox VerticalAlignment="Center" ItemsSource="{Binding AvailableNpcGroups}" SelectedItem="{Binding SelectedGroupFilter3, Mode=TwoWay}" ToolTip="{l:Loc selectGroupToFilterBy}" Visibility="{Binding IsGroupSearch3, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                 <ComboBox VerticalAlignment="Center" IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding AvailableRaces}" Text="{Binding SearchText3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:Loc filterByRaceTip}" Visibility="{Binding IsRaceSearch3, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                             </Grid>
                         </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <RadioButton Content="{l:Loc aNDMatchAll}" GroupName="{l:Loc searchLogic}" VerticalAlignment="Center" Margin="0,0,10,0" 
                                         ToolTip="{l:Loc resultsMustMatchAll}"
                                         IsChecked="{Binding CurrentSearchLogic, Mode=TwoWay, Converter={StaticResource EnumMatchToBooleanConverter}, ConverterParameter={x:Static vm:SearchLogic.AND}}"/>
                            <RadioButton Content="{l:Loc oRMatchAny}" GroupName="{l:Loc searchLogic}" VerticalAlignment="Center" 
                                         ToolTip="{l:Loc resultsMustMatchAt}"
                                         IsChecked="{Binding CurrentSearchLogic, Mode=TwoWay, Converter={StaticResource EnumMatchToBooleanConverter}, ConverterParameter={x:Static vm:SearchLogic.OR}}"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                            <TextBlock Text="{l:Loc sortBy}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox ItemsSource="{Binding Source={StaticResource NpcSortPropertyEnumValues}}"
                                      SelectedItem="{Binding SelectedSortProperty, Mode=TwoWay}"
                                      MinWidth="80" VerticalAlignment="Center" Margin="0,0,10,0"
                                      ToolTip="{l:Loc changeTheSortOrder}"/>
                            <CheckBox Content="{l:Loc reverse}" IsChecked="{Binding IsSortReversed, Mode=TwoWay}" 
                                      VerticalAlignment="Center" ToolTip="{l:Loc reverseTheCurrentSort}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- NPC Navigation Buttons -->
                <Border DockPanel.Dock="Bottom" BorderThickness="0,1,1,0" BorderBrush="{DynamicResource BorderBrush}" Padding="2">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="NavPreviousButton" ToolTip="{l:Loc previousNPCInList}" Padding="4,2" Margin="2,0"
                                MinWidth="28" MinHeight="22"
                                Command="{Binding NavigatePreviousNpcCommand}">
                            <TextBlock Text="▲" FontSize="11"/>
                        </Button>
                        <Button x:Name="NavNextButton" ToolTip="{l:Loc nextNPCInList}" Padding="4,2" Margin="2,0"
                                MinWidth="28" MinHeight="22"
                                Command="{Binding NavigateNextNpcCommand}">
                            <TextBlock Text="▼" FontSize="11"/>
                        </Button>
                        <Button x:Name="NavBackButton" ToolTip="{l:Loc goToPreviouslyViewed}" Padding="4,2" Margin="2,0"
                                MinWidth="28" MinHeight="22"
                                Command="{Binding NavigateBackNpcCommand}">
                            <TextBlock Text="◀" FontSize="11"/>
                        </Button>
                        <Button x:Name="NavForwardButton" ToolTip="{l:Loc goToNextViewed}" Padding="4,2" Margin="2,0"
                                MinWidth="28" MinHeight="22"
                                Command="{Binding NavigateForwardNpcCommand}">
                            <TextBlock Text="▶" FontSize="11"/>
                        </Button>
                    </StackPanel>
                </Border>
                 <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource BorderBrush}">
                    <ListBox x:Name="NpcListBox" ItemsSource="{Binding FilteredNpcs}"
                             SelectedItem="{Binding SelectedNpc, Mode=TwoWay}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Stretch"
                             SelectionChanged="NpcListBox_OnSelectionChanged">
                         <ListBox.ItemTemplate>
                             <DataTemplate>
                                 <Border BorderBrush="{Binding SelectionIndicatorBrush}">
                                     <Border.Style>
                                         <Style TargetType="Border">
                                             <Setter Property="BorderThickness" Value="0"/>
                                             <Setter Property="Padding" Value="0"/>
                                             <Style.Triggers>
                                                 <MultiDataTrigger>
                                                     <MultiDataTrigger.Conditions>
                                                         <Condition Binding="{Binding DataContext.NpcSelectionIndicator, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="Bar"/>
                                                         <Condition Binding="{Binding SelectionIndicatorBrush, Converter={StaticResource IsNotNullConverter}}" Value="True"/>
                                                     </MultiDataTrigger.Conditions>
                                                     <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                                     <Setter Property="Padding" Value="6,0,0,0"/>
                                                 </MultiDataTrigger>
                                             </Style.Triggers>
                                         </Style>
                                     </Border.Style>
                                     <Border.ToolTip>
                                         <ToolTip>
                                              <StackPanel>
                                                   <TextBlock Text="{Binding NpcName}" /> 
                                                   <TextBlock Text="{Binding NpcEditorId}" /> 
                                                   <TextBlock Text="{Binding NpcFormKeyString}" />
                                                   <TextBlock Text="{Binding FormIdString}" />
                                                   <TextBlock Text="{Binding NpcGroupsDisplay}" />
                                              </StackPanel>
                                         </ToolTip>
                                     </Border.ToolTip>
                                     <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{l:Loc includeOutfits}"
                                                      ItemsSource="{Binding Source={StaticResource OutfitOverrideEnumValues}}">
                                                <MenuItem.ItemContainerStyle>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                        <Setter Property="Header" Value="{Binding Converter={StaticResource EnumDescConverter}}"/>
                                                        <Setter Property="IsCheckable" Value="True"/>
        
                                                        <Setter Property="Command" Value="{Binding Path=DataContext.SetNpcOutfitOverrideCommand, Source={StaticResource DataContextProxy}}"/>

                                                        <Setter Property="CommandParameter">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource TupleConverter}">
                                                                    <Binding Path="."/>
                                                                    <Binding Path="PlacementTarget.DataContext" RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="IsChecked">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource OutfitOverrideStateConverter}" Mode="OneWay">
                                                                    <Binding Path="." />
                                                                    <Binding Path="PlacementTarget.DataContext.NpcFormKey" 
                                                                             RelativeSource="{RelativeSource AncestorType=ContextMenu}"
                                                                             Mode="OneWay"/>
                    
                                                                    <Binding Path="DataContext" Source="{StaticResource DataContextProxy}" />

                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </MenuItem.ItemContainerStyle>
                                            </MenuItem>
                                            <MenuItem Header="{l:Loc render}" SubmenuOpened="RenderSubmenu_OnSubmenuOpened">
                                                <MenuItem Header="{l:Loc overrideGlobalSetting}"
                                                          IsCheckable="True"
                                                          IsChecked="{Binding RenderOverrideGlobal, Mode=TwoWay}"
                                                          ToolTip="{l:Loc whenCheckedThisNPC}"/>
                                                <MenuItem Header="{l:Loc includeDefaultOutfit}"
                                                          IsCheckable="True"
                                                          IsChecked="{Binding RenderIncludeDefaultOutfit, Mode=TwoWay}"
                                                          IsEnabled="{Binding RenderOverrideGlobal}"
                                                          ToolTip="{l:Loc renderThisNPCWearing}"/>
                                                <MenuItem Header="{l:Loc includeHeadgear}"
                                                          IsCheckable="True"
                                                          IsChecked="{Binding RenderIncludeHeadgear, Mode=TwoWay}"
                                                          IsEnabled="{Binding RenderHeadgearEnabled}"
                                                          ToolTip="{l:Loc renderThisNPC}"/>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="{l:Loc addFaceFromFavorites}"
                                                      Command="{Binding Path=DataContext.AddFavoriteFaceToNpcCommand, Source={StaticResource DataContextProxy}}"
                                                      CommandParameter="{Binding}"/>
                                            <Separator Visibility="{Binding HasTemplateReferences, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <MenuItem Header="{l:Loc jumpToTemplateReference}"
                                                      ItemsSource="{Binding TemplateReferenceEntries}"
                                                      Command="{Binding Path=DataContext.JumpToTemplateReferenceCommand, Source={StaticResource DataContextProxy}}"
                                                      CommandParameter="{Binding TemplateReferenceEntries[0].NpcFormKey}"
                                                      Visibility="{Binding HasTemplateReferences, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TemplateReferenceEntries.Count}" Value="1">
                                                                <Setter Property="ItemsSource" Value="{x:Null}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TemplateReferenceEntries.Count, Converter={StaticResource IsGreaterThanOneConverter}}" Value="True">
                                                                <Setter Property="Command" Value="{x:Null}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                                <MenuItem.ItemContainerStyle>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                        <Setter Property="Header" Value="{Binding DisplayText}"/>
                                                        <Setter Property="Command" Value="{Binding Path=DataContext.JumpToTemplateReferenceCommand, Source={StaticResource DataContextProxy}}"/>
                                                        <Setter Property="CommandParameter" Value="{Binding NpcFormKey}"/>
                                                    </Style>
                                                </MenuItem.ItemContainerStyle>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="{l:Loc copy}">
                                                <MenuItem Header="{l:Loc formID}"
                                                          Command="{Binding CopyFormIdCommand}"
                                                          ToolTip="{l:Loc copyThisNPCS}"/>
                                                <MenuItem Header="{l:Loc formKey}"
                                                          Command="{Binding CopyFormKeyCommand}"
                                                          ToolTip="{l:Loc copyThisNPC}"/>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                     <Grid>
                                         <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="Auto"/>
                                             <ColumnDefinition Width="*"/>
                                             <ColumnDefinition Width="Auto"/>
                                         </Grid.ColumnDefinitions>

                                         <!-- Left-side template indicators -->
                                         <StackPanel Grid.Column="0" Orientation="Horizontal">
                                             <StackPanel.Style>
                                                 <Style TargetType="StackPanel">
                                                     <Setter Property="Visibility" Value="Collapsed"/>
                                                     <Style.Triggers>
                                                         <MultiDataTrigger>
                                                             <MultiDataTrigger.Conditions>
                                                                 <Condition Binding="{Binding DataContext.ShowTemplateStatusInList, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"/>
                                                                 <Condition Binding="{Binding DataContext.TemplateIconPosition, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="Left"/>
                                                             </MultiDataTrigger.Conditions>
                                                             <Setter Property="Visibility" Value="Visible"/>
                                                         </MultiDataTrigger>
                                                     </Style.Triggers>
                                                 </Style>
                                             </StackPanel.Style>
                                             <!-- Grey "T" for winning-override template sources -->
                                             <TextBlock Text="{l:Loc t}" FontWeight="Bold" Foreground="Gray" Margin="0,0,2,0"
                                                        ToolTip="{Binding WinningOverrideTemplateUsersTooltip}"
                                                        Visibility="{Binding IsWinningOverrideTemplateSource, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                             <!-- Purple/Green "T" for app-mod template sources -->
                                             <TextBlock Text="{l:Loc t}" FontWeight="Bold" Margin="0,0,2,0"
                                                        ToolTip="{Binding AppModTemplateTooltip}">
                                                 <TextBlock.Style>
                                                     <Style TargetType="TextBlock">
                                                         <Setter Property="Visibility" Value="Collapsed"/>
                                                         <Setter Property="Foreground" Value="MediumPurple"/>
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding ShowAppModTemplateT}" Value="True">
                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                             </DataTrigger>
                                                             <DataTrigger Binding="{Binding IsAppModTemplateGreen}" Value="True">
                                                                 <Setter Property="Foreground" Value="LimeGreen"/>
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </TextBlock.Style>
                                             </TextBlock>
                                             <!-- Red "!" for template conflict -->
                                             <TextBlock Text="!" FontWeight="Bold" Foreground="Red" Margin="0,0,3,0"
                                                        ToolTip="{Binding TemplateConflictTooltip}"
                                                        Visibility="{Binding HasTemplateConflict, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                         </StackPanel>

                                         <TextBlock Grid.Column="1" Text="{Binding DisplayName}">
                                             <TextBlock.Style>
                                                 <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                     <Style.Triggers>
                                                         <MultiDataTrigger>
                                                             <MultiDataTrigger.Conditions>
                                                                 <Condition Binding="{Binding DataContext.NpcSelectionIndicator, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="Text Color"/>
                                                                 <Condition Binding="{Binding SelectionIndicatorBrush, Converter={StaticResource IsNotNullConverter}}" Value="True"/>
                                                             </MultiDataTrigger.Conditions>
                                                             <Setter Property="Foreground" Value="{Binding SelectionIndicatorBrush}"/>
                                                         </MultiDataTrigger>
                                                     </Style.Triggers>
                                                 </Style>
                                             </TextBlock.Style>
                                         </TextBlock>

                                         <!-- Right-side template indicators -->
                                         <StackPanel Grid.Column="2" Orientation="Horizontal">
                                             <StackPanel.Style>
                                                 <Style TargetType="StackPanel">
                                                     <Setter Property="Visibility" Value="Collapsed"/>
                                                     <Style.Triggers>
                                                         <MultiDataTrigger>
                                                             <MultiDataTrigger.Conditions>
                                                                 <Condition Binding="{Binding DataContext.ShowTemplateStatusInList, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"/>
                                                                 <Condition Binding="{Binding DataContext.TemplateIconPosition, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="Right"/>
                                                             </MultiDataTrigger.Conditions>
                                                             <Setter Property="Visibility" Value="Visible"/>
                                                         </MultiDataTrigger>
                                                     </Style.Triggers>
                                                 </Style>
                                             </StackPanel.Style>
                                             <!-- Grey "T" for winning-override template sources -->
                                             <TextBlock Text="{l:Loc t}" FontWeight="Bold" Foreground="Gray" Margin="3,0,0,0"
                                                        ToolTip="{Binding WinningOverrideTemplateUsersTooltip}"
                                                        Visibility="{Binding IsWinningOverrideTemplateSource, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                             <!-- Purple/Green "T" for app-mod template sources -->
                                             <TextBlock Text="{l:Loc t}" FontWeight="Bold" Margin="2,0,0,0"
                                                        ToolTip="{Binding AppModTemplateTooltip}">
                                                 <TextBlock.Style>
                                                     <Style TargetType="TextBlock">
                                                         <Setter Property="Visibility" Value="Collapsed"/>
                                                         <Setter Property="Foreground" Value="MediumPurple"/>
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding ShowAppModTemplateT}" Value="True">
                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                             </DataTrigger>
                                                             <DataTrigger Binding="{Binding IsAppModTemplateGreen}" Value="True">
                                                                 <Setter Property="Foreground" Value="LimeGreen"/>
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </TextBlock.Style>
                                             </TextBlock>
                                             <!-- Red "!" for template conflict -->
                                             <TextBlock Text="!" FontWeight="Bold" Foreground="Red" Margin="2,0,0,0"
                                                        ToolTip="{Binding TemplateConflictTooltip}"
                                                        Visibility="{Binding HasTemplateConflict, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                         </StackPanel>
                                     </Grid>
                                 </Border>
                             </DataTemplate>
                         </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource BorderBrush}" ResizeBehavior="PreviousAndNext" x:Name="ColumnSplitter"/>

            <ScrollViewer Grid.Column="2" x:Name="ImageDisplayScrollViewer"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          SizeChanged="ImageDisplayScrollViewer_SizeChanged"
                          PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                 <ItemsControl x:Name="AppearanceModsItemsControl" ItemsSource="{Binding CurrentNpcAppearanceMods}" AllowDrop="True">
                     <ItemsControl.ItemsPanel>
                         <ItemsPanelTemplate>
                             <WrapPanel Orientation="Horizontal"
                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
                         </ItemsPanelTemplate>
                     </ItemsControl.ItemsPanel>
                     <ItemsControl.ItemTemplate>
                         <DataTemplate DataType="{x:Type vm:VM_NpcsMenuMugshot}">
                             <Border 
                                 BorderThickness="{Binding MugshotBorderThickness,
                                      RelativeSource={RelativeSource AncestorType={x:Type local:NpcsView}}}"
                                 Margin="{Binding MugshotMargin,
                                     RelativeSource={RelativeSource AncestorType={x:Type local:NpcsView}}}"
                                 Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 BorderBrush="{Binding BorderColor}"
                                 Width="{Binding ImageWidth}"
                                 Height="{Binding ImageHeight}"
                                 dd:DragDrop.IsDragSource="True"
                                 dd:DragDrop.IsDropTarget="True"
                                 dd:DragDrop.DragHandler="{Binding}"
                                 dd:DragDrop.DropHandler="{Binding}"
                                 dd:DragDrop.DragDropContext="{Binding}"
                                 AllowDrop="True"
                                 ContextMenuOpening="MugshotBorder_OnContextMenuOpening"
                                 dd:DragDrop.DragAdornerTemplate="{StaticResource AppearanceModDragAdorner}">
                                 <i:Interaction.Triggers>
                                     <i:EventTrigger EventName="MouseLeftButtonUp">
                                         <i:InvokeCommandAction Command="{Binding SelectCommand}" />
                                     </i:EventTrigger>
                                 </i:Interaction.Triggers>
                                 <!-- PreviewMouseRightButtonDown sits on the Grid (not the Image)
                                      so the Ctrl+RClick / Ctrl+Shift+RClick shortcuts keep working
                                      when the Image is collapsed in Live Tile mode. -->
                                 <Grid Background="Black"
                                       PreviewMouseRightButtonDown="Image_PreviewMouseRightButtonDown"> <!-- This Grid is the reference for CheckBox width -->
                                     <Image Source="{Binding MugshotSource}" Stretch="UniformToFill" ToolTip="{Binding ToolTipString}">
                                         <Image.Style>
                                             <Style TargetType="Image">
                                                 <Setter Property="Opacity" Value="1.0" />
                                                 <Style.Triggers>
                                                     <DataTrigger Binding="{Binding MugshotSource}" Value="{x:Null}"> <Setter Property="Opacity" Value="0.5"/> </DataTrigger>
                                                     <DataTrigger Binding="{Binding MugshotSource}" Value=""> <Setter Property="Opacity" Value="0.5"/> </DataTrigger>
                                                     <DataTrigger Binding="{Binding IsLiveTile}" Value="True"> <Setter Property="Visibility" Value="Collapsed"/> </DataTrigger>
                                                 </Style.Triggers>
                                             </Style>
                                         </Image.Style>
                                     </Image>

                                     <!-- Live Tile: embedded view-only 3D viewport replacing the
                                          static image. DataContext is the tile's per-instance
                                          preview VM (null while the tile is a plain mugshot, so
                                          the collapsed control never starts GL). -->
                                     <local:UC_LiveTileViewport DataContext="{Binding LiveTilePreview}"
                                                                Visibility="{Binding DataContext.IsLiveTile, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                     <Image x:Name="LoadingDragonImage"
                                        Source="pack://siteoforigin:,,,/Resources/RedDragon.png"
                                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        RenderTransformOrigin="0.5,0.5"
                                        Width="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=ActualWidth, Converter={StaticResource PercentageSizingConverter}, ConverterParameter='50'}"
                                        Height="{Binding RelativeSource={RelativeSource Self}, Path=Width}">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <TransformGroup>
                                                        <TranslateTransform Y="0" />
                                                        <RotateTransform Angle="0" />
                                                    </TransformGroup>
                                                </Setter.Value>
                                            </Setter>

                                            <Setter Property="local:DynamicRadiusBehavior.ImageWidth" Value="{Binding ImageWidth}" />
                                            <Setter Property="local:DynamicRadiusBehavior.ImageHeight" Value="{Binding ImageHeight}" />
                                            <Setter Property="local:DynamicRadiusBehavior.RadiusMultiplier" Value="0.25" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="OrbitDragon_BeginStoryboard">
                                                            <Storyboard>
                                                                <DoubleAnimation
                                                                    Storyboard.TargetProperty="RenderTransform.Children[1].Angle"
                                                                    From="0" To="360" Duration="0:0:3"
                                                                    RepeatBehavior="Forever" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="OrbitDragon_BeginStoryboard"/>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                     
                                     <TextBlock Text="{Binding ModName}" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                Background="{DynamicResource MugshotCaptionBackground}" 
                                                Foreground="{DynamicResource MugshotCaptionForeground}" 
                                                FontSize="10" Padding="3,1"
                                                TextTrimming="CharacterEllipsis" ToolTip="{Binding ModName}"/>
                                     
                                     <!-- Badge overlay layer: every informational badge/indicator
                                          lives inside this wrapper so Live Tile mode can hide them
                                          all at once (the viewport should stay clean; the compare
                                          checkbox and caption deliberately remain outside/visible).
                                          The wrapper stretches over the whole tile, so the
                                          AncestorType=Grid width bindings inside resolve to the
                                          same size as before. -->
                                     <Grid Visibility="{Binding IsLiveTile, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">

                                     <!-- Top-left vertical stack: an icon row (issue-notification
                                          "!" and, beside it, the "no antlers" and "has wig" head-
                                          editing badges) on top, with the FaceGen-stats text overlay
                                          below. Each child controls its own Visibility so any can
                                          show alone without leaving an empty slot; the horizontal row
                                          lets each badge shift right to clear the ones before it,
                                          only when they are shown. -->
                                     <StackPanel Orientation="Vertical"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Top">

                                         <!-- Top-left icon row: issue "!" (left) then the
                                              antlers-removed and has-wig badges (right). A collapsed
                                              child takes zero width, so the badges sit flush-left
                                              when no earlier icon is present. -->
                                         <StackPanel Orientation="Horizontal">

                                         <!-- Outer Container for Issue Notification Indicator -->
                                         <Grid x:Name="IssueIndicatorContainerGrid"
                                               Width="{Binding ElementName=CompareCheckBox, Path=ActualWidth}"
                                               Height="{Binding ElementName=CompareCheckBox, Path=ActualHeight}"
                                               Visibility="{Binding HasIssueNotification, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               ToolTip="{Binding IssueNotificationText}">

                                             <!-- Inner Viewbox to scale the "!" and center it
                                                  (Template and other generic issues) -->
                                             <Viewbox Stretch="Uniform"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center">
                                                 <Viewbox.Style>
                                                     <Style TargetType="Viewbox">
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding IssueType}" Value="FaceGenOnly">
                                                                 <Setter Property="Visibility" Value="Collapsed"/>
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </Viewbox.Style>
                                                 <!-- Red by default. A Template issue that the
                                                      current Template Handling Mode defuses (the
                                                      chain gets flattened, so this mod's choice
                                                      does apply to this NPC) drops to the theme's
                                                      warning colour instead. -->
                                                 <TextBlock Text="!"
                                                            FontWeight="Bold">
                                                     <TextBlock.Style>
                                                         <Style TargetType="TextBlock">
                                                             <Setter Property="Foreground" Value="Red"/>
                                                             <Style.Triggers>
                                                                 <DataTrigger Binding="{Binding TemplateResolvesPerNpc}" Value="True">
                                                                     <Setter Property="Foreground"
                                                                             Value="{DynamicResource StatusWarningForeground}"/>
                                                                 </DataTrigger>
                                                             </Style.Triggers>
                                                         </Style>
                                                     </TextBlock.Style>
                                                 </TextBlock>
                                             </Viewbox>

                                             <!-- FaceGen-only issues (mod ships FaceGen but no
                                                  plugin record for this NPC) use a dedicated icon -->
                                             <Image Source="pack://siteoforigin:,,,/Resources/No Npc Record.png"
                                                    Stretch="Uniform">
                                                 <Image.Style>
                                                     <Style TargetType="Image">
                                                         <Setter Property="Visibility" Value="Collapsed"/>
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding IssueType}" Value="FaceGenOnly">
                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </Image.Style>
                                             </Image>
                                         </Grid>

                                         <!-- Antlers-removed badge: this mod's effective Antler
                                              Handling Mode is Remove and the patch strips an antler
                                              this NPC actually carries, so the depicted/patched NPC
                                              has no antlers. Sits to the right of the issue "!".
                                              Sized to 20% of the tile (matching the Missing-Asset
                                              and Multi-plugin badges) rather than the 10% issue
                                              indicator, so it reads at the same scale. -->
                                         <Grid Width="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=ActualWidth, Converter={StaticResource PercentageSizingConverter}, ConverterParameter='20'}"
                                               Height="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=ActualWidth, Converter={StaticResource PercentageSizingConverter}, ConverterParameter='20'}"
                                               Visibility="{Binding HasAntlerRemovalNotice, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               ToolTip="{Binding AntlerRemovalNoticeText}">
                                             <Viewbox Stretch="Uniform"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center">
                                                 <Image Source="pack://siteoforigin:,,,/Resources/No Antlers.png" />
                                             </Viewbox>
                                         </Grid>

                                         <!-- Has-wig badge: this NPC wears a wig this mod supplies
                                              (a hair-slot armor via its skin/WornArmor or its Default
                                              Outfit). Informational and mode-independent — it flags
                                              that the depicted appearance includes a wig. Sits to the
                                              right of the antlers badge in the same head-editing row;
                                              a collapsed sibling takes zero width, so whichever badges
                                              apply stay flush-left. Sized to 20% to match the antler
                                              badge. -->
                                         <Grid Width="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=ActualWidth, Converter={StaticResource PercentageSizingConverter}, ConverterParameter='20'}"
                                               Height="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=ActualWidth, Converter={StaticResource PercentageSizingConverter}, ConverterParameter='20'}"
                                               Visibility="{Binding HasWigNotice, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               ToolTip="{Binding WigNoticeText}">
                                             <Viewbox Stretch="Uniform"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center">
                                                 <!-- White glow: the icon is thin dark line art, and in
                                                      the second row slot it lands on the mugshot's hair
                                                      region, which is often just as dark — without a
                                                      halo it camouflages entirely. The effect goes on
                                                      the Viewbox, not the Image: inside the Viewbox it
                                                      would be authored at the bitmap's natural size and
                                                      scale down with it, shrinking the blur to
                                                      sub-pixel invisibility. -->
                                                 <Viewbox.Effect>
                                                     <DropShadowEffect Color="White" ShadowDepth="0"
                                                                       BlurRadius="6" Opacity="0.9"/>
                                                 </Viewbox.Effect>
                                                 <Image Source="pack://siteoforigin:,,,/Resources/Has Wig.png" />
                                             </Viewbox>

                                             <!-- Crossed out when the wig will NOT reach the output
                                                  (Wig Handling Mode inert AND the outfit carrying it
                                                  not forwarded). The mugshot draws the wig regardless
                                                  — it is the NPC's hair — so without this the tile
                                                  would promise an appearance the patch won't deliver.
                                                  Drawn as vector strokes rather than an icon asset so
                                                  it stays crisp at the 20% tile sizing; sized to the
                                                  badge by filling the same Grid cell. StrokeThickness
                                                  is in the Viewbox's own 0..10 space, so it scales
                                                  with the badge instead of hairlining at small tiles. -->
                                             <Viewbox Stretch="Fill"
                                                      Visibility="{Binding WigNotPersisted, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                 <!-- Same white halo as the icon: the X lands on hair,
                                                      which is usually as dark as the stroke. -->
                                                 <Viewbox.Effect>
                                                     <DropShadowEffect Color="White" ShadowDepth="0"
                                                                       BlurRadius="6" Opacity="0.9"/>
                                                 </Viewbox.Effect>
                                                 <Canvas Width="10" Height="10">
                                                     <Path Stroke="Red" StrokeThickness="1.4"
                                                           StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                           Data="M 1,1 L 9,9 M 9,1 L 1,9"/>
                                                 </Canvas>
                                             </Viewbox>
                                         </Grid>

                                         </StackPanel>

                                         <!-- FaceGen-stats text overlay (TextOverlay display mode).
                                              Stacked TextBlocks, one per enabled metric. FontSize
                                              binds to TextOverlayFontSize which scales with
                                              ImageHeight * TextHeightPercent. Per-line color is
                                              HighlightColor when this tile is an outlier in that
                                              metric, otherwise NoHighlightColor. -->
                                         <StackPanel Margin="3,1,0,0"
                                                     IsHitTestVisible="False"
                                                     Visibility="{Binding ShowFaceGenTextOverlay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                             <TextBlock Text="{Binding FaceGenVertText}"
                                                        FontSize="{Binding FaceGenTextFontSize}"
                                                        FontWeight="Bold"
                                                        Foreground="{Binding FaceGenVertColor}"
                                                        Visibility="{Binding ShowFaceGenVertLine, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                             <TextBlock Text="{Binding FaceGenPolyText}"
                                                        FontSize="{Binding FaceGenTextFontSize}"
                                                        FontWeight="Bold"
                                                        Foreground="{Binding FaceGenPolyColor}"
                                                        Visibility="{Binding ShowFaceGenPolyLine, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                             <TextBlock Text="{Binding FaceGenSizeText}"
                                                        FontSize="{Binding FaceGenTextFontSize}"
                                                        FontWeight="Bold"
                                                        Foreground="{Binding FaceGenSizeColor}"
                                                        Visibility="{Binding ShowFaceGenSizeLine, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                         </StackPanel>
                                     </StackPanel>
                                     
                                     <!-- Bottom-right horizontal stack: Missing-asset icon (left)
                                          and Multi-plugins icon (right), side-by-side. Each
                                          controls its own Visibility; when only one is visible
                                          the StackPanel shrinks so the visible icon stays flush
                                          to the right edge. -->
                                     <StackPanel Orientation="Horizontal"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Bottom"
                                                 Margin="0,0,0,16">

                                         <!-- Margin's bottom value clears the ModName caption
                                              (FontSize 10 + 1px vertical padding) so the icons
                                              sit above the text rather than overlapping it. -->

                                         <!-- Outfit-conflict indicator: "Include Outfit" is
                                              overridden at runtime by SkyPatcher/SPID, or NPC2's
                                              SkyPatcher ini entry is not conflict-winning; the
                                              tooltip explains which config wins and why. -->
                                         <Grid Width="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=ActualWidth, Converter={StaticResource PercentageSizingConverter}, ConverterParameter='20'}"
                                               Height="{Binding RelativeSource={RelativeSource Self}, Path=Width}"
                                               Visibility="{Binding HasOutfitNotice, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               ToolTip="{Binding OutfitNoticeText}">
                                             <Viewbox Stretch="Uniform">
                                                 <TextBlock Text="⚠" FontWeight="Bold" Foreground="Orange"/>
                                             </Viewbox>
                                         </Grid>

                                         <!-- Missing-asset indicator: fires for unresolved meshes
                                              OR textures; the tooltip enumerates each category
                                              under its own heading. -->
                                         <Grid Width="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=ActualWidth, Converter={StaticResource PercentageSizingConverter}, ConverterParameter='20'}"
                                               Height="{Binding RelativeSource={RelativeSource Self}, Path=Width}"
                                               Visibility="{Binding HasMissingAssets, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               ToolTip="{Binding MissingAssetNotificationText}">
                                             <Viewbox Stretch="Uniform">
                                                 <Image Source="pack://siteoforigin:,,,/Resources/Missing Asset.png" />
                                             </Viewbox>
                                         </Grid>

                                         <!-- Missing-outfit-assets indicator: the outfit/headgear
                                              is missing meshes or textures (installable — re-render
                                              picks them up), and/or an outfit mesh links an SMP/HDT
                                              physics XML that doesn't exist (informational — render
                                              is correct). Kept separate from the base missing-asset
                                              icon above. -->
                                         <Grid Width="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=ActualWidth, Converter={StaticResource PercentageSizingConverter}, ConverterParameter='20'}"
                                               Height="{Binding RelativeSource={RelativeSource Self}, Path=Width}"
                                               Visibility="{Binding HasMissingOutfitAssets, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               ToolTip="{Binding MissingOutfitAssetsText}">
                                             <Viewbox Stretch="Uniform">
                                                 <Image Source="pack://siteoforigin:,,,/Resources/Missing Outfit Assets.png" />
                                             </Viewbox>
                                         </Grid>

                                         <!-- Data-folder-assets indicator: the render pulled
                                              non-vanilla assets from the data folder because they
                                              weren't in this mod's Corresponding Mod Folders — a
                                              keep-activated runtime dependency. Informational
                                              (the render is correct); the tooltip lists the
                                              assets. -->
                                         <Grid Width="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=ActualWidth, Converter={StaticResource PercentageSizingConverter}, ConverterParameter='20'}"
                                               Height="{Binding RelativeSource={RelativeSource Self}, Path=Width}"
                                               Visibility="{Binding HasDataFolderAssets, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               ToolTip="{Binding DataFolderAssetsText}">
                                             <Viewbox Stretch="Uniform">
                                                 <Image Source="pack://siteoforigin:,,,/Resources/Data Folder Assets.png" />
                                             </Viewbox>
                                         </Grid>

                                         <!-- Multiple-plugins indicator: NPC is defined in
                                              multiple source plugins; right-click to pick the
                                              correct source. -->
                                         <Grid Width="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=ActualWidth, Converter={StaticResource PercentageSizingConverter}, ConverterParameter='20'}"
                                               Height="{Binding RelativeSource={RelativeSource Self}, Path=Width}"
                                               Visibility="{Binding IsAmbiguousSource, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               ToolTip="{l:Loc thisNPCIsDefined}">
                                             <Viewbox Stretch="Uniform">
                                                 <Image Source="pack://siteoforigin:,,,/Resources/Multiple Plugins for NPC.png" />
                                             </Viewbox>
                                         </Grid>
                                     </StackPanel>

                                     <!-- FaceGen-stats indicator dot (Tooltip display mode).
                                          Position is driven by FaceGenIndicatorPosition (mirror
                                          of the user's FaceGenTooltipPosition setting): four
                                          values - CenterLeft / CenterRight / BottomCenter /
                                          TopCenter. CenterLeft is the default because the side
                                          border-space is usually free of hair/chin overlap.
                                          ToolTip enumerates all enabled stats; fill color uses
                                          HighlightColor when any metric is an outlier. -->
                                     <Grid Width="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=ActualWidth, Converter={StaticResource PercentageSizingConverter}, ConverterParameter='10'}"
                                           Height="{Binding RelativeSource={RelativeSource Self}, Path=Width}"
                                           Visibility="{Binding ShowFaceGenIndicator, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           ToolTip="{Binding FaceGenStatsTooltip}">
                                         <Grid.Style>
                                             <Style TargetType="Grid">
                                                 <Style.Triggers>
                                                     <DataTrigger Binding="{Binding FaceGenIndicatorPosition}" Value="CenterLeft">
                                                         <Setter Property="HorizontalAlignment" Value="Left"/>
                                                         <Setter Property="VerticalAlignment" Value="Center"/>
                                                         <Setter Property="Margin" Value="3,0,0,0"/>
                                                     </DataTrigger>
                                                     <DataTrigger Binding="{Binding FaceGenIndicatorPosition}" Value="CenterRight">
                                                         <Setter Property="HorizontalAlignment" Value="Right"/>
                                                         <Setter Property="VerticalAlignment" Value="Center"/>
                                                         <Setter Property="Margin" Value="0,0,3,0"/>
                                                     </DataTrigger>
                                                     <DataTrigger Binding="{Binding FaceGenIndicatorPosition}" Value="BottomCenter">
                                                         <Setter Property="HorizontalAlignment" Value="Center"/>
                                                         <Setter Property="VerticalAlignment" Value="Bottom"/>
                                                         <Setter Property="Margin" Value="0,0,0,18"/>
                                                     </DataTrigger>
                                                     <DataTrigger Binding="{Binding FaceGenIndicatorPosition}" Value="TopCenter">
                                                         <Setter Property="HorizontalAlignment" Value="Center"/>
                                                         <Setter Property="VerticalAlignment" Value="Top"/>
                                                         <Setter Property="Margin" Value="0,2,0,0"/>
                                                     </DataTrigger>
                                                 </Style.Triggers>
                                             </Style>
                                         </Grid.Style>
                                         <Ellipse Fill="{Binding FaceGenIndicatorColor}"
                                                  Stroke="Black" StrokeThickness="0.5"/>
                                     </Grid>

                                     <!-- Outer Container for No Data Notification Indicator (Bottom-Left) -->
                                     <Grid x:Name="NoDataIndicatorContainerGrid"
                                           HorizontalAlignment="Left" 
                                           VerticalAlignment="Bottom"
                                           Width="{Binding ElementName=CompareCheckBox, Path=ActualWidth}"  
                                           Height="{Binding ElementName=CompareCheckBox, Path=ActualHeight}" 
                                           Visibility="{Binding HasNoData, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           ToolTip="{Binding NoDataNotificationText}"
                                           Margin="0,0,0,0"> 
                                         
                                         <!-- Inner Viewbox to scale the "!" and center it -->
                                         <Viewbox Stretch="Uniform" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center">
                                             <Image Source="pack://siteoforigin:,,,/Resources/No Associated Data.png" />
                                         </Viewbox>
                                     </Grid>
                                     
                                     <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 0 0 10"
                                           Visibility="{Binding IsGuestAppearance, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           Width="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=ActualWidth, Converter={StaticResource PercentageSizingConverter}, ConverterParameter='20'}"
                                           Height="{Binding RelativeSource={RelativeSource Self}, Path=Width}">

                                         <Grid.ToolTip>
                                             <ToolTip>
                                                 <ToolTip.Content>
                                                     <TextBlock>
                                                         <TextBlock.Text>
                                                             <MultiBinding StringFormat="{l:Loc guestAppearanceTooltip}">
                                                                 <Binding Path="OriginalTargetName"/>
                                                                 <Binding Path="TargetDisplayName"/>
                                                             </MultiBinding>
                                                         </TextBlock.Text>
                                                     </TextBlock>
                                                 </ToolTip.Content>
                                             </ToolTip>
                                         </Grid.ToolTip>

                                         <Viewbox Stretch="Uniform">
                                             <Image Source="pack://siteoforigin:,,,/Resources/Guest Plugin.png"/>
                                         </Viewbox>
                                     </Grid>
                                     
                                     <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 0 0 10"
                                           ToolTip="{Binding ShareSourceTooltipText}"
                                           Width="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=ActualWidth, Converter={StaticResource PercentageSizingConverter}, ConverterParameter='20'}"
                                           Height="{Binding RelativeSource={RelativeSource Self}, Path=Width}">
                                         <Grid.Style>
                                             <Style TargetType="Grid">
                                                 <Setter Property="Visibility" Value="Collapsed" />
                                                 <Style.Triggers>
                                                     <MultiDataTrigger>
                                                         <MultiDataTrigger.Conditions>
                                                             <Condition Binding="{Binding IsShareSource}" Value="True" />
                                                             <Condition Binding="{Binding IsGuestAppearance}" Value="False" />
                                                         </MultiDataTrigger.Conditions>
                                                         <Setter Property="Visibility" Value="Visible" />
                                                     </MultiDataTrigger>
                                                 </Style.Triggers>
                                             </Style>
                                         </Grid.Style>

                                         <Viewbox Stretch="Uniform">
                                             <Image>
                                                 <Image.Style>
                                                     <Style TargetType="Image">
                                                         <Setter Property="Source" Value="pack://siteoforigin:,,,/Resources/SourcePlugin.png"/>
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding IsSelectedByGuest}" Value="True">
                                                                 <Setter Property="Source" Value="pack://siteoforigin:,,,/Resources/SelectedSourcePlugin.png"/>
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </Image.Style>
                                             </Image>
                                         </Viewbox>
                                     </Grid>

                                     </Grid> <!-- End badge overlay layer (hidden in Live Tile mode) -->

                                     <CheckBox x:Name="CompareCheckBox"
                                               IsChecked="{Binding IsCheckedForCompare, Mode=TwoWay}"
                                               VerticalAlignment="Top" HorizontalAlignment="Right"
                                               Margin="0" Padding="0"
                                               Width="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=ActualWidth, Converter={StaticResource PercentageSizingConverter}, ConverterParameter='10'}"
                                               Height="{Binding RelativeSource={RelativeSource Self}, Path=Width}"
                                               Background="Transparent"
                                               BorderBrush="Transparent"
                                               Foreground="White"
                                               BorderThickness="0"
                                               ToolTip="{l:Loc selectThisMugshotFor}">
                                         <CheckBox.Style>
                                             <Style TargetType="CheckBox">
                                                 <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                 <Setter Property="Template">
                                                     <Setter.Value>
                                                         <ControlTemplate TargetType="CheckBox">
                                                             <Grid Width="{TemplateBinding Width}"
                                                                   Height="{TemplateBinding Height}"
                                                                   Background="{TemplateBinding Background}"
                                                                   SnapsToDevicePixels="True">
                                                                 <Line X1="0.5" Y1="0"
                                                                       X2="0.5" Y2="{Binding Path=ActualHeight, RelativeSource={RelativeSource TemplatedParent}}"
                                                                       Stroke="White" StrokeThickness="1" SnapsToDevicePixels="True"/>
                                                                 <Line X1="0" Y1="{Binding Path=ActualHeight, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource LineOffsetConverter}}"
                                                                       X2="{Binding Path=ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Y2="{Binding Path=ActualHeight, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource LineOffsetConverter}}"
                                                                       Stroke="White" StrokeThickness="1" SnapsToDevicePixels="True"/>
                                                                 <Viewbox Stretch="Uniform" Margin="2">
                                                                     <Path x:Name="CheckMark"
                                                                           Data="M 0 5 L 3.5 8.5 L 8.5 0"
                                                                           Stroke="{TemplateBinding Foreground}"
                                                                           StrokeThickness="1.5"
                                                                           Visibility="Collapsed"/>
                                                                 </Viewbox>
                                                             </Grid>
                                                             <ControlTemplate.Triggers>
                                                                 <Trigger Property="IsChecked" Value="True">
                                                                     <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                                                 </Trigger>
                                                                 <Trigger Property="IsMouseOver" Value="True">
                                                                     <Setter Property="Cursor" Value="Hand"/>
                                                                 </Trigger>
                                                             </ControlTemplate.Triggers>
                                                         </ControlTemplate>
                                                     </Setter.Value>
                                                 </Setter>
                                             </Style>
                                         </CheckBox.Style>
                                     </CheckBox>
                                 </Grid>
                                 <Border.ContextMenu>
                                     <ContextMenu>
                                         <MenuItem Header="{l:Loc select}" Command="{Binding SelectCommand}" />
                                         <MenuItem Header="{l:Loc hide}" Command="{Binding HideCommand}" />
                                         <MenuItem Header="{l:Loc unhide}" Command="{Binding UnhideCommand}" />
                                         <Separator />
                                         <MenuItem Header="{l:Loc selectAllFromThis}" Command="{Binding SelectAllFromThisModCommand}" />
                                         <MenuItem Header="{l:Loc selectAvailableFromThis}" Command="{Binding SelectAvailableFromThisModCommand}" />
                                         <MenuItem Header="{l:Loc selectVisibleFromThis}" Command="{Binding SelectVisibleFromThisModCommand}" />
                                         <MenuItem Header="{l:Loc selectVisibleAmpAvailable}" Command="{Binding SelectVisibleAndAvailableFromThisModCommand}" />
                                         <MenuItem Header="{l:Loc unselectAllFromThis}" Command="{Binding UnselectAllFromThisModCommand}" />
                                         <MenuItem Header="{l:Loc unselectVisibleFromThis}" Command="{Binding UnselectVisibleFromThisModCommand}" />
                                         <Separator />
                                         <MenuItem Header="{l:Loc hideAllFromThis}" Command="{Binding HideAllFromThisModCommand}" />
                                         <MenuItem Header="{l:Loc unhideAllFromThis}" Command="{Binding UnhideAllFromThisModCommand}" />
                                         <Separator />
                                         <MenuItem Header="{l:Loc jumpToMod}" Command="{Binding JumpToModCommand}" Visibility="{Binding CanJumpToMod, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                         <MenuItem Header="{l:Loc jumpToTemplate}" Command="{Binding JumpToTemplateCommand}" Visibility="{Binding CanJumpToTemplate, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                         <Separator/>
                                    
                                        <MenuItem Header="{l:Loc selectSourcePlugin}"
                                                    Visibility="{Binding IsAmbiguousSource, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    ItemsSource="{Binding AvailableSourcePlugins}">
                                            <MenuItem.ItemContainerStyle>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                    <Setter Property="Header" Value="{Binding Converter={StaticResource ModKeyToStringConverter}}"/>
                                                    <Setter Property="Command" Value="{Binding DataContext.SetNpcSourcePluginCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                                    <Setter Property="IsCheckable" Value="True"/>
                                                    <Setter Property="IsChecked">
                                                        <Setter.Value>
                                                            <MultiBinding Converter="{StaticResource AreModKeysEqualMultiConverter}">
                                                                <Binding Path="."/>
                                                                <Binding Path="DataContext.CurrentSourcePlugin" RelativeSource="{RelativeSource AncestorType=ContextMenu}"/>
                                                            </MultiBinding>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </MenuItem.ItemContainerStyle>
                                        </MenuItem>
                                        <MenuItem Header="{l:Loc selectSameSourcePlugin}"
                                                    Visibility="{Binding IsAmbiguousSource, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Command="{Binding SelectSameSourcePluginWherePossibleCommand}"
                                                    ToolTip="{l:Loc forAllOtherAmbiguous}"/>
                                        <Separator Visibility="{Binding IsAmbiguousSource, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                         
                                         <MenuItem Header="{l:Loc showFullImageCtrl}" Command="{Binding ToggleFullScreenCommand}"/>
                                         <MenuItem Header="{l:Loc show3DPreviewCtrl}" Command="{Binding Show3DPreviewCommand}"/>
                                         <MenuItem Command="{Binding ToggleLiveTileCommand}"
                                                   ToolTip="{l:Loc liveTileViewportExplanation}">
                                             <MenuItem.Style>
                                                 <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                     <Setter Property="Header" Value="Make Live Tile"/>
                                                     <Style.Triggers>
                                                         <DataTrigger Binding="{Binding IsLiveTile}" Value="True">
                                                             <Setter Property="Header" Value="Make Mugshot"/>
                                                         </DataTrigger>
                                                     </Style.Triggers>
                                                 </Style>
                                             </MenuItem.Style>
                                         </MenuItem>
                                         <Separator/>
                                         <MenuItem Header="{l:Loc generateMugshot}"
                                                   Command="{Binding GenerateMugshotCommand}"
                                                   Visibility="{Binding CanGenerateMugshot, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                   ToolTip="{l:Loc renderNowTooltip}"/>
                                         <MenuItem Header="{Binding DeleteMugshotHeader}"
                                                   Command="{Binding DeleteMugshotCommand}"
                                                   Visibility="{Binding CanDeleteMugshot, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                   ToolTip="{l:Loc deleteTileImageTooltip}"/>
                                         <Separator/>
                                         <MenuItem Command="{Binding ShareWithNpcCommand}"
                                                   Header="{l:Loc shareWithNPC}"
                                                   ToolTip="{l:Loc makeThisAppearanceAvailable}">
                                             <MenuItem.Style>
                                                 <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                     <Setter Property="Visibility" Value="Visible"/>
                                                     <Style.Triggers>
                                                         <DataTrigger Binding="{Binding IsGuestAppearance}" Value="True">
                                                             <Setter Property="Visibility" Value="Collapsed"/>
                                                         </DataTrigger>
                                                     </Style.Triggers>
                                                 </Style>
                                             </MenuItem.Style>
                                         </MenuItem>

                                         <MenuItem Command="{Binding UnshareFromNpcCommand}"
                                                   Header="{l:Loc unshareFromThisNpc}"
                                                   ToolTip="{l:Loc removeThisGuestAppearance}">
                                             <MenuItem.Style>
                                                 <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                     <Setter Property="Visibility" Value="Collapsed"/>
                                                     <Style.Triggers>
                                                         <DataTrigger Binding="{Binding IsGuestAppearance}" Value="True">
                                                             <Setter Property="Visibility" Value="Visible"/>
                                                         </DataTrigger>
                                                     </Style.Triggers>
                                                 </Style>
                                             </MenuItem.Style>
                                         </MenuItem>
                                         <MenuItem Command="{Binding AddToFavoritesCommand}">
                                             <MenuItem.Style>
                                                 <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                     <Setter Property="Header" Value="{Binding FavoriteMenuItemText}"/>
                                                 </Style>
                                             </MenuItem.Style>
                                         </MenuItem>
                                         <Separator/>
                                         <MenuItem Header="{l:Loc openModFolder}" 
                                                   ItemsSource="{Binding AssociatedModSetting.CorrespondingFolderPaths}"
                                                   Command="{Binding OpenFolderCommand}"
                                                   CommandParameter="{Binding AssociatedModSetting.CorrespondingFolderPaths[0]}"
                                                   Visibility="{Binding CanOpenModFolder, Converter={StaticResource BooleanToVisibilityConverter}}">
                                             <MenuItem.Style>
                                                 <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                     <Style.Triggers>
                                                         <DataTrigger Binding="{Binding AssociatedModSetting.CorrespondingFolderPaths.Count}" Value="1">
                                                             <Setter Property="ItemsSource" Value="{x:Null}"/>
                                                         </DataTrigger>
                                                         <DataTrigger Binding="{Binding AssociatedModSetting.CorrespondingFolderPaths.Count, Converter={StaticResource IsGreaterThanOneConverter}}" Value="True">
                                                             <Setter Property="Command" Value="{x:Null}"/>
                                                         </DataTrigger>
                                                     </Style.Triggers>
                                                 </Style>
                                             </MenuItem.Style>
                                             <MenuItem.ItemContainerStyle>
                                                 <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                     <Setter Property="Header" Value="{Binding Converter={StaticResource PathToFolderNameConverter}}"/>
                                                     <Setter Property="Command" Value="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                     <Setter Property="CommandParameter" Value="{Binding}"/>
                                                 </Style>
                                             </MenuItem.ItemContainerStyle>
                                         </MenuItem>
                                         <MenuItem Header="{l:Loc openMugshotFolder}" 
                                                   Command="{Binding OpenFolderCommand}"
                                                   CommandParameter="{Binding MugshotFolderPath}"
                                                   Visibility="{Binding CanOpenMugshotFolder, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                         <MenuItem Header="{l:Loc visitModPage}"
                                                   ItemsSource="{Binding ModPageUrls}"
                                                   DisplayMemberPath="DisplayName"
                                                   Visibility="{Binding CanVisitModPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                             <MenuItem.ItemContainerStyle>
                                                 <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                     <Setter Property="Command" Value="{Binding DataContext.VisitModPageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                     <Setter Property="CommandParameter" Value="{Binding Url}"/>
                                                 </Style>
                                             </MenuItem.ItemContainerStyle>
                                         </MenuItem>
                                     </ContextMenu>
                                 </Border.ContextMenu>
                             </Border>
                         </DataTemplate>
                     </ItemsControl.ItemTemplate>
                 </ItemsControl>
             </ScrollViewer>

            <TextBlock Grid.Column="2" Text="{l:Loc selectAnNPC}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource HintForeground}" TextWrapping="Wrap" Margin="20">
                 <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedNpc}" Value="{x:Null}"> <Setter Property="Visibility" Value="Visible"/> <Setter Property="Text" Value="Select an NPC from the list on the left to see appearance options."/> </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions> <Condition Binding="{Binding SelectedNpc, Converter={StaticResource IsNotNullConverter}}" Value="True" /> <Condition Binding="{Binding CurrentNpcAppearanceMods.Count}" Value="0" /> </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" /> <Setter Property="Text" Value="No appearance options found for the selected NPC."/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- Description Panel, Mugshot Source Override & Zoom Controls (Grid.Row="2") -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/> <!-- Description Area -->
                    <ColumnDefinition Width="Auto"/> <!-- Mugshot Source Override -->
                    <ColumnDefinition Width="Auto"/> <!-- Zoom Controls -->
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource PrimaryBackground}" Padding="0" VerticalAlignment="Center"
                        Visibility="{Binding ShowNpcDescriptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentNpcDescription}" Value="{x:Null}"> <Setter Property="Visibility" Value="Collapsed"/> </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentNpcDescription}" Value="{x:Static System:String.Empty}"> <Setter Property="Visibility" Value="Collapsed"/> </DataTrigger>
                                <DataTrigger Binding="{Binding ShowNpcDescriptions}" Value="False"> <Setter Property="Visibility" Value="Collapsed"/> </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid MinHeight="25">
                        <ScrollViewer MaxHeight="40" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding CurrentNpcDescription}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource PrimaryForeground}"/>
                        </ScrollViewer>
                        <TextBlock Text="{l:Loc loadingDescription}" FontStyle="Italic" Foreground="{DynamicResource HintForeground}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IsLoadingDescription, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                </Border>
                <!-- Mugshot Source Override: transient per-NPC priority bump.
                     Click MD/FF/AG to promote that source to the top of the
                     priority list for the currently-selected NPC; click the
                     active button again, or switch NPCs, to clear and fall
                     back to Settings.MugshotSourcePriority. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNpc}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{l:Loc mugshotSource}" VerticalAlignment="Center" Margin="0,0,5,0"
                               Foreground="{DynamicResource PrimaryForeground}"/>
                    <RadioButton Content="{l:Loc mD}" GroupName="{l:Loc mugshotSourceOverride}" Margin="2,0" VerticalAlignment="Center"
                                 IsEnabled="{Binding IsManualDownloadSourceAvailable}"
                                 ToolTipService.ShowOnDisabled="True"
                                 Command="{Binding ToggleMugshotSourceOverrideCommand}"
                                 CommandParameter="{x:Static models:MugshotSourceType.DownloadedMugshots}"
                                 IsChecked="{Binding MugshotSourceOverride, Mode=OneWay,
                                     Converter={StaticResource EnumMatchToBooleanConverter},
                                     ConverterParameter=DownloadedMugshots}">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                                <Setter Property="ToolTip" Value="Show Manual-Download mugshots first for this NPC. Click again to clear."/>
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="ToolTip" Value="Set a valid Mugshots Folder in Settings to use this option."/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>
                    <RadioButton Content="{l:Loc fF}" GroupName="{l:Loc mugshotSourceOverride}" Margin="2,0" VerticalAlignment="Center"
                                 IsEnabled="{Binding IsFaceFinderSourceAvailable}"
                                 ToolTipService.ShowOnDisabled="True"
                                 Command="{Binding ToggleMugshotSourceOverrideCommand}"
                                 CommandParameter="{x:Static models:MugshotSourceType.FaceFinder}"
                                 IsChecked="{Binding MugshotSourceOverride, Mode=OneWay,
                                     Converter={StaticResource EnumMatchToBooleanConverter},
                                     ConverterParameter=FaceFinder}">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                                <Setter Property="ToolTip" Value="Show FaceFinder mugshots first for this NPC. Click again to clear."/>
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="ToolTip" Value="Enable 'Use FaceFinder API for missing mugshots' in Settings to use this option."/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>
                    <RadioButton Content="{l:Loc aG}" GroupName="{l:Loc mugshotSourceOverride}" Margin="2,0" VerticalAlignment="Center"
                                 IsEnabled="{Binding IsAutoGenSourceAvailable}"
                                 ToolTipService.ShowOnDisabled="True"
                                 Command="{Binding ToggleMugshotSourceOverrideCommand}"
                                 CommandParameter="{x:Static models:MugshotSourceType.AutoGeneration}"
                                 IsChecked="{Binding MugshotSourceOverride, Mode=OneWay,
                                     Converter={StaticResource EnumMatchToBooleanConverter},
                                     ConverterParameter=AutoGeneration}">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                                <Setter Property="ToolTip" Value="Show Auto-Generated mugshots first for this NPC. Any whose render was missing assets is re-rendered now against the mod's current folders. Click again to clear."/>
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="ToolTip" Value="Enable 'Auto-Generate missing mugshots' in Settings to use this option."/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="ZoomOutButton" Content="-" Width="25" Height="25" Margin="2,0" ToolTip="{l:Loc zoomOutCtrlScroll}"/>
                    <TextBox x:Name="ZoomPercentageTextBox" Width="60" Height="25" Margin="2,0" TextAlignment="Center" VerticalContentAlignment="Center"
                             Text="{Binding NpcsViewZoomLevel, StringFormat='F2', Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PreviewMouseWheel="ZoomPercentageTextBox_PreviewMouseWheel"
                             ToolTip="{l:Loc currentZoomLevel}"/>
                    <TextBlock Text="%" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Button x:Name="ZoomInButton" Content="+" Width="25" Height="25" Margin="2,0" ToolTip="{l:Loc zoomInCtrlScroll}"/>
                    <CheckBox x:Name="LockZoomCheckBox" Content="{l:Loc lockZoom}" Margin="10,0,5,0" VerticalAlignment="Center" ToolTip="{l:Loc lockTheCurrentZoom}"/>
                    <Button x:Name="ResetZoomNpcsButton" Content="{l:Loc resetZoom}" Margin="5,0,0,0" Padding="5,2"
                            Command="{Binding ResetZoomNpcsCommand}"
                            ToolTip="{l:Loc resetZoomToAutomatically}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</reactiveui:ReactiveUserControl>