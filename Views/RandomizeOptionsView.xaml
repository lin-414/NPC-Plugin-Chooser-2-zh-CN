<Window x:Class="NPC_Plugin_Chooser_2.Views.RandomizeOptionsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NPC_Plugin_Chooser_2.Views"
        xmlns:vm="clr-namespace:NPC_Plugin_Chooser_2.View_Models"
        xmlns:themes="clr-namespace:NPC_Plugin_Chooser_2.Themes"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:l="clr-namespace:NPC_Plugin_Chooser_2.Localization"
        mc:Ignorable="d"
        Style="{DynamicResource ThemedWindowStyle}"
        Title="{l:Loc randomizeAppearances}" Height="640" Width="470" MinWidth="380" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        d:DataContext="{d:DesignInstance Type=vm:VM_RandomizeOptions}">

    <i:Interaction.Behaviors>
        <themes:TitleBarThemingBehavior />
    </i:Interaction.Behaviors>

    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:EnumMatchToBooleanConverter x:Key="EnumMatchToBooleanConverter"/>
    </Window.Resources>

    <DockPanel Margin="12">
        <!-- Action buttons -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button Content="{l:Loc clearRandomizedNPCs}" DockPanel.Dock="Left" HorizontalAlignment="Left" Padding="8,3"
                    Command="{Binding ClearRandomizedNpcsCommand}"
                    ToolTip="{l:Loc deselectEveryNPCWhose}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{l:Loc randomize}" MinWidth="90" Margin="5,0" IsDefault="True"
                        Command="{Binding OkCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                <Button Content="{l:Loc cancel}" MinWidth="90" Margin="5,0" IsCancel="True"
                        Command="{Binding CancelCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            </StackPanel>
        </DockPanel>

        <!-- Options above the mod list -->
        <StackPanel DockPanel.Dock="Top">
            <!-- Scope -->
            <TextBlock Text="{l:Loc applyTo}" FontWeight="Bold" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="6,0,0,8">
                <RadioButton Content="{l:Loc visibleFilteredNPCs}" GroupName="{l:Loc scope}" Margin="0,0,15,0"
                             IsChecked="{Binding Scope, Converter={StaticResource EnumMatchToBooleanConverter}, ConverterParameter=VisibleNpcs}"/>
                <RadioButton Content="{l:Loc allNPCs}" GroupName="{l:Loc scope}"
                             IsChecked="{Binding Scope, Converter={StaticResource EnumMatchToBooleanConverter}, ConverterParameter=AllNpcs}"/>
            </StackPanel>

            <Separator Margin="0,2,0,8"/>

            <!-- Base appearance -->
            <CheckBox IsChecked="{Binding AllowBaseMod}" Margin="0,0,0,6"
                      Content="{l:Loc allowBaseAppearance}"
                      ToolTip="{l:Loc ifUncheckedANon}"/>

            <!-- Shared appearances -->
            <CheckBox IsChecked="{Binding AllowSharedAppearance}" Margin="0,0,0,4"
                      Content="{l:Loc allowSharedAppearances}"
                      ToolTip="{l:Loc allowBorrowingAFace}"/>

            <Border Margin="18,0,0,6" Padding="8,6" BorderBrush="Gray" BorderThickness="1" CornerRadius="3"
                    Visibility="{Binding AllowSharedAppearance, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <CheckBox IsChecked="{Binding ForceSharedAppearance}" Margin="0,0,0,4"
                              Content="{l:Loc forceSharedAppearance}"
                              ToolTip="{l:Loc ifCheckedOnlyBorrowed}"/>
                    <CheckBox IsChecked="{Binding ShareFromSameRace}" Margin="0,0,0,4"
                              Content="{l:Loc matchRace}"
                              ToolTip="{l:Loc onlyFacesFromNPCs}"/>
                    <CheckBox IsChecked="{Binding ShareFromSameGender}" Margin="0,0,0,4"
                              Content="{l:Loc matchGender}"
                              ToolTip="{l:Loc onlyFacesFrom}"/>
                    <CheckBox IsChecked="{Binding ShareFromSameWeight}" Margin="0,0,0,4"
                              Content="{l:Loc matchWeight}"
                              ToolTip="{l:Loc onlyFaces}"/>
                    <CheckBox IsChecked="{Binding AllowDuplicateShares}"
                              Content="{l:Loc allowDuplicateShares}"
                              ToolTip="{l:Loc ifUncheckedTheSame}"/>
                </StackPanel>
            </Border>

            <!-- Single-option NPCs -->
            <CheckBox IsChecked="{Binding AllowSingleOptionNpcs}" Margin="0,0,0,6"
                      Content="{l:Loc allowSingleOptionNPCs}"
                      ToolTip="{l:Loc ifUncheckedAnNPC}"/>

            <Separator Margin="0,2,0,8"/>

            <!-- Appearance source -->
            <TextBlock Text="{l:Loc appearanceSource}" FontWeight="Bold" Margin="0,0,0,4"/>
            <ComboBox Margin="6,0,0,8" HorizontalAlignment="Left" MinWidth="200"
                      ItemsSource="{Binding AvailableAppearanceSources}"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding AppearanceSource}"/>
        </StackPanel>

        <!-- Mod checklist (fills remaining space) -->
        <Grid Visibility="{Binding IsModListVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,2,0,4">
                <TextBlock Text="{l:Loc eligibleMods}" FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="{l:Loc selectAll}" Padding="6,1" Margin="0,0,4,0" Command="{Binding SelectAllCommand}"
                            ToolTip="{l:Loc checkEveryModIn}"/>
                    <Button Content="{l:Loc selectVisible}" Padding="6,1" Margin="0,0,4,0" Command="{Binding SelectVisibleCommand}"
                            ToolTip="{l:Loc checkEveryModCurrently}"/>
                    <Button Content="{l:Loc selectNone}" Padding="6,1" Command="{Binding SelectNoneCommand}"
                            ToolTip="{l:Loc uncheckEveryModIn}"/>
                </StackPanel>
            </DockPanel>

            <TextBox Grid.Row="1" Margin="0,0,0,4"
                     Text="{Binding ModFilterText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{l:Loc filterThe}"/>

            <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" CornerRadius="2">
                <ListBox ItemsSource="{Binding FilteredMods}"
                         HorizontalContentAlignment="Stretch"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:VM_SelectableModSetting}">
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Content="{Binding DisplayName}"
                                      ToolTip="{Binding DisplayName}"
                                      Margin="2,1"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
    </DockPanel>
</Window>
